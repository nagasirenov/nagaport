/** Original-source selector/shader and independent OBJ parser; native Minecraft/Forge only. */
public final class FluidDuctModelNativeTest {
 static int checks;static final BlockPos POS=new BlockPos(8,64,8);static FluidDuctStandard duct;
 static final int[] COLORS={0x888888,0xff00ff,0x010203,0x7f3d19,0x12abef,0xffffff,0x000000,0xa53c72e9};
 static final String[] SKINS={"pipe_neo","pipe_silver","pipe_colored"};
 static final class Sprite extends TextureAtlasSprite {
  Sprite(String name,int index){super(name);setIconWidth(16);setIconHeight(16);initSprite(512,128,16*index,32,false);}
 }
 static void check(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
 static void close(float got,float want,String message){check(Math.abs(got-want)<0.000003F,message+": "+got+" != "+want);}
 static void setup(){duct=new FluidDuctStandard(Material.IRON);duct.setTranslationKey("fluid_duct_neo");ForgeRegistries.BLOCKS.register(duct.setRegistryName("hbm","tile.fluid_duct_neo"));ForgeRegistries.ITEMS.register(new ItemBlock(duct){public int getMetadata(int damage){return damage;}}.setHasSubtypes(true).setRegistryName(duct.getRegistryName()));}
 static IBlockState state(int meta,int mask,int color){return ((IExtendedBlockState)duct.getStateFromMeta(meta)).withProperty(ConnectionState.CONNECTIONS,mask).withProperty(FluidConnectionState.FLUID_COLOR,color);}
 static Sprite sprite(int meta,boolean overlay){return new Sprite("hbm:blocks/"+SKINS[Math.abs(meta%3)]+(overlay?"_overlay":""),1+2*Math.abs(meta%3)+(overlay?1:0));}
 static final class Face {String group;float[][] xyz,uv;float[] normal;}
 static Map<String,List<Face>> originalObj(Reader source)throws Exception{
  List<float[]> points=new ArrayList<>(),uvs=new ArrayList<>();Map<String,List<Face>> groups=new LinkedHashMap<>();BufferedReader in=new BufferedReader(source);String line,group=null;
  while((line=in.readLine())!=null){String[] p=line.trim().split("\\s+");if(p[0].equals("o")||p[0].equals("g")){group=p[1];groups.put(group,new ArrayList<>());}
   else if(p[0].equals("v"))points.add(new float[]{Float.parseFloat(p[1]),Float.parseFloat(p[2]),Float.parseFloat(p[3])});
   else if(p[0].equals("vt"))uvs.add(new float[]{Float.parseFloat(p[1]),1-Float.parseFloat(p[2])});
   else if(p[0].equals("f")){check(p.length==4||p.length==5,"original triangle/quad primitive");Face f=new Face();f.group=group;f.xyz=new float[p.length-1][];f.uv=new float[p.length-1][];
    for(int i=1;i<p.length;i++){String[] k=p[i].split("/");f.xyz[i-1]=points.get(Integer.parseInt(k[0])-1);f.uv[i-1]=uvs.get(Integer.parseInt(k[1])-1);}
    double ax=f.xyz[1][0]-f.xyz[0][0],ay=f.xyz[1][1]-f.xyz[0][1],az=f.xyz[1][2]-f.xyz[0][2],bx=f.xyz[2][0]-f.xyz[0][0],by=f.xyz[2][1]-f.xyz[0][1],bz=f.xyz[2][2]-f.xyz[0][2];
    double nx=ay*bz-az*by,ny=az*bx-ax*bz,nz=ax*by-ay*bx,length=(float)Math.sqrt(nx*nx+ny*ny+nz*nz);
    f.normal=new float[]{(float)(nx/length),(float)(ny/length),(float)(nz/length)};groups.get(group).add(f);
   }
  }
  check(groups.keySet().equals(new LinkedHashSet<String>(Arrays.asList("pZ","pX","nZ","nX","pY","nnn","nnp","pnp","pnn","ppn","npn","npp","ppp","nY"))),"exact original fluid group set");return groups;
 }

 static final class Expected {final float[][] vertices=new float[4][5];float nx,ny,nz;int color;TextureAtlasSprite sprite;String group;boolean overlay;}
 static List<Expected> oracle(Map<String,List<Face>> source,int mask,boolean inventory,int color,TextureAtlasSprite base,TextureAtlasSprite overlay){
  List<Expected> out=new ArrayList<>();
  for(OriginalFluidOracle.Layer layer:OriginalFluidOracle.layers(mask,inventory))for(Face f:source.get(layer.group)){
   Expected q=new Expected();q.sprite=layer.overlay?overlay:base;q.group=layer.group;q.overlay=layer.overlay;
   q.nx=inventory?-f.normal[0]:f.normal[0];q.ny=f.normal[1];q.nz=inventory?-f.normal[2]:f.normal[2];
   q.color=OriginalFluidOracle.originalColor(f.normal[0],f.normal[1],f.normal[2],!inventory,layer.overlay,color);
   for(int v=0;v<4;v++){int i=Math.min(v,f.xyz.length-1);float[] p=f.xyz[i],uv=f.uv[i];
    q.vertices[v][0]=(float)(p[0]*(inventory?-1.25D:1D)+.5D);q.vertices[v][1]=(float)(p[1]*(inventory?1.25D:1D)+.5D);q.vertices[v][2]=(float)(p[2]*(inventory?-1.25D:1D)+.5D);
    q.vertices[v][3]=q.sprite.getInterpolatedU(uv[0]*16D);q.vertices[v][4]=q.sprite.getInterpolatedV(uv[1]*16D);
   }out.add(q);
  }return out;
 }
 static void geometry(List<BakedQuad> actual,List<Expected> expected,boolean inventory,String context){
  check(actual.size()==expected.size(),context+" pristine quad count "+actual.size()+" != "+expected.size());
  for(int i=0;i<actual.size();i++){
   BakedQuad q=actual.get(i);Expected want=expected.get(i);String part=context+" "+want.group+(want.overlay?" overlay":" base")+" quad "+i;
   check(q.getSprite()==want.sprite,part+" exact source layer ordering and atlas sprite");check(q.shouldApplyDiffuseLighting()==inventory&&!q.hasTintIndex(),part+" native diffuse flag and baked RGB rather than tint callback");
   check(q.getFormat().equals(inventory?DefaultVertexFormats.ITEM:DefaultVertexFormats.BLOCK),part+" native format");int[] bytes=q.getVertexData();check(bytes.length==28,part+" four native vertices");
   for(int v=0;v<4;v++){int k=7*v;float[] e=want.vertices[v];String label=part+" vertex "+v;
    close(Float.intBitsToFloat(bytes[k]),e[0],label+" original X");close(Float.intBitsToFloat(bytes[k+1]),e[1],label+" original Y");close(Float.intBitsToFloat(bytes[k+2]),e[2],label+" original Z");
    close(Float.intBitsToFloat(bytes[k+4]),e[3],label+" original uncontracted U");close(Float.intBitsToFloat(bytes[k+5]),e[4],label+" original uncontracted V");
    check(bytes[k+3]==want.color,label+" original per-channel RGB-before-shading truncation: "+Integer.toHexString(bytes[k+3])+" != "+Integer.toHexString(want.color));
    if(inventory){int n=bytes[k+6];check((byte)n==(byte)(want.nx*127F)&&(byte)(n>>8)==(byte)(want.ny*127F)&&(byte)(n>>16)==(byte)(want.nz*127F),label+" original signed-byte normal");}
   }
  }
  try{actual.add(null);throw new AssertionError("mutable duct quad list");}catch(UnsupportedOperationException expectedFailure){checks++;}
 }
 static final class LightingWorld implements IBlockAccess {
  final IBlockState state;final int own=0x00A00070;
  LightingWorld(IBlockState state){this.state=state;}
  public TileEntity getTileEntity(BlockPos p){return null;}
  public int getCombinedLight(BlockPos p,int emission){return p.equals(POS)?own:0x00100010*((Math.abs(p.getX()+2*p.getY()+3*p.getZ())%8)+1);}
  public IBlockState getBlockState(BlockPos p){return p.equals(POS)?state:Blocks.STONE.getDefaultState();}
  public boolean isAirBlock(BlockPos p){return false;}
  public net.minecraft.world.biome.Biome getBiome(BlockPos p){return Biomes.PLAINS;}
  public int getStrongPower(BlockPos p,EnumFacing side){return 0;}
  public WorldType getWorldType(){return WorldType.DEFAULT;}
  public boolean isSideSolid(BlockPos p,EnumFacing side,boolean fallback){return !p.equals(POS);}
 }
 static void lighting(IBakedModel model,IBlockState state,String context){
  LightingWorld world=new LightingWorld(state);net.minecraft.client.renderer.color.BlockColors colors=new net.minecraft.client.renderer.color.BlockColors();List<BakedQuad> quads=model.getQuads(state,null,0);
  for(boolean forge:new boolean[]{false,true}){
   net.minecraft.client.renderer.BufferBuilder out=new net.minecraft.client.renderer.BufferBuilder(65536);out.begin(7,DefaultVertexFormats.BLOCK);
   if(forge){net.minecraftforge.client.model.pipeline.VertexLighterFlat lighter=new net.minecraftforge.client.model.pipeline.VertexLighterFlat(colors);
    net.minecraftforge.client.model.pipeline.VertexBufferConsumer consumer=new net.minecraftforge.client.model.pipeline.VertexBufferConsumer(out);consumer.setOffset(POS);lighter.setParent(consumer);lighter.setWorld(world);lighter.setState(state);lighter.setBlockPos(POS);lighter.updateBlockInfo();
    for(BakedQuad q:quads)q.pipe(lighter);lighter.resetBlockInfo();
   }else check(new net.minecraft.client.renderer.BlockModelRenderer(colors).renderModelFlat(world,model,state,POS,out,true,0),context+" native vanilla emits model");
   out.finishDrawing();check(out.getVertexCount()==quads.size()*4,context+" native emitted vertices "+forge);java.nio.ByteBuffer data=out.getByteBuffer();
   for(int v=0;v<out.getVertexCount();v++){
    check(data.getInt(v*28+24)==world.own,context+" "+(forge?"Forge":"vanilla")+" original block-position light, not neighbor at vertex "+v+": "+Integer.toHexString(data.getInt(v*28+24)));
    check(data.getInt(v*28+12)==quads.get(v/4).getVertexData()[v%4*7+3],context+" original tinted shading without doubled diffuse "+forge);
   }
  }
 }

 static void direct(IResourcePack pack,Map<String,List<Face>> original)throws Exception{
  ObjMesh mesh;ResourceLocation asset=new ResourceLocation("hbm","models/blocks/pipe_neo.obj");try(Reader r=new InputStreamReader(pack.getInputStream(asset),StandardCharsets.UTF_8)){mesh=ObjMeshParser.parse(r,asset.toString(),false);}
  for(int meta=0;meta<3;meta++){
   TextureAtlasSprite base=sprite(meta,false),overlay=sprite(meta,true);IBakedModel worldModel=new FluidDuctBakedModel(mesh,meta,false,base,overlay,OriginalFluidOracle.NONE_COLOR);
   check(!worldModel.isAmbientOcclusion()&&worldModel.isGui3d()&&!worldModel.isBuiltInRenderer(),"native non-AO 3D duct");check(worldModel.getParticleTexture()==base,"base-layer particle skin");close(worldModel.getItemCameraTransforms().gui.scale.x,.625F,"native GUI transform");check(worldModel.getOverrides().getOverrides().isEmpty(),"no invented overrides");
   for(int color:COLORS){
    IBakedModel itemModel=new FluidDuctBakedModel(mesh,meta,true,base,overlay,color);
    for(int mask=0;mask<64;mask++){
     String label="metadata="+meta+" mask="+mask+" color="+Integer.toHexString(color);IBlockState state=state(meta,mask,color);List<Expected> expected=oracle(original,mask,false,color,base,overlay);
     geometry(RenderTestPipe.bake(mesh,mask,false,color,base,overlay),expected,false,label+" direct world");geometry(worldModel.getQuads(state,null,17),expected,false,label+" baked world");
     check(worldModel.getQuads(state,null,0)==worldModel.getQuads(state,null,99),label+" cached immutable mask/color variant ignores RNG");
     for(EnumFacing face:EnumFacing.values())check(worldModel.getQuads(state,face,0).isEmpty()&&itemModel.getQuads(state,face,0).isEmpty(),label+" general bucket only "+face);
     if(color==COLORS[mask%COLORS.length]&&meta==0)lighting(worldModel,state,label);
     if(mask==0){List<Expected> expectedItem=oracle(original,0,true,color,base,overlay);geometry(RenderTestPipe.bake(mesh,0,true,color,base,overlay),expectedItem,true,label+" original item");geometry(itemModel.getQuads(state,null,0),expectedItem,true,label+" item model");}
     check(itemModel.getQuads(state,null,0)==itemModel.getQuads(null,null,1),label+" inventory ignores connection/color state");
    }
   }
   List<Expected> fallback=oracle(original,0,false,0xff00ff,base,overlay);geometry(worldModel.getQuads(null,null,0),fallback,false,"null state original magenta fallback");geometry(worldModel.getQuads(duct.getStateFromMeta(meta),null,0),fallback,false,"missing unlisted values original fallback");
   geometry(worldModel.getQuads(((IExtendedBlockState)duct.getStateFromMeta(meta)).withProperty(ConnectionState.CONNECTIONS,42),null,0),oracle(original,42,false,0xff00ff,base,overlay),false,"missing color retains supplied mask");
   geometry(worldModel.getQuads(((IExtendedBlockState)duct.getStateFromMeta(meta)).withProperty(FluidConnectionState.FLUID_COLOR,0xabcdef),null,0),oracle(original,0,false,0xabcdef,base,overlay),false,"missing mask retains supplied color");
   List<BakedQuad> before=worldModel.getQuads(state(meta,17,0x123456),null,0);
   for(int i=0;i<260;i++)worldModel.getQuads(state(meta,i%64,i*65537),null,i);
   check(((Map<?,?>)get(worldModel,FluidDuctBakedModel.class,"variants")).size()<=128,"bounded tint/mask cache");
   geometry(before,oracle(original,17,false,0x123456,base,overlay),false,"evicted list remains unchanged");geometry(worldModel.getQuads(state(meta,17,0x123456),null,0),oracle(original,17,false,0x123456,base,overlay),false,"evicted variant correctly regenerated");
   for(boolean layer:new boolean[]{false,true}){ResourceLocation png=new ResourceLocation("hbm","textures/blocks/"+SKINS[meta]+(layer?"_overlay":"")+".png");check(pack.resourceExists(png),"exact-case original sprite exists");try(InputStream in=pack.getInputStream(png)){check(ImageIO.read(in)!=null,"original sprite PNG decodes");}}
  }
  for(int mask:new int[]{-1,64})try{RenderTestPipe.bake(mesh,mask,false,0xffffff,sprite(0,false),sprite(0,true));throw new AssertionError("invalid mask accepted");}catch(IllegalArgumentException expected){checks++;}
  for(int meta:new int[]{-1,16})try{new FluidDuctBakedModel(mesh,meta,false,sprite(0,false),sprite(0,true),0x888888);throw new AssertionError("invalid metadata accepted");}catch(IllegalArgumentException expected){checks++;}
 }
 static sun.misc.Unsafe unsafe;static SimpleReloadableResourceManager sharedResources;
 static void set(Object o,Class<?> c,String field,Object value)throws Exception{Field f=c.getDeclaredField(field);f.setAccessible(true);f.set(o,value);}
 static Object get(Object o,Class<?> c,String field)throws Exception{Field f=c.getDeclaredField(field);f.setAccessible(true);return f.get(o);}
 static void event()throws Exception{
  Class<?> type=com.hbm.main.FluidDuctModelHandler.class;net.minecraftforge.fml.common.Mod.EventBusSubscriber ann=type.getAnnotation(net.minecraftforge.fml.common.Mod.EventBusSubscriber.class);
  check(ann!=null&&ann.modid().equals("hbm")&&Arrays.equals(ann.value(),new net.minecraftforge.fml.relauncher.Side[]{net.minecraftforge.fml.relauncher.Side.CLIENT}),"native automatic client-only subscriber");int count=0;
  for(Method m:type.getDeclaredMethods())if(m.isAnnotationPresent(net.minecraftforge.fml.common.eventhandler.SubscribeEvent.class)&&Arrays.equals(m.getParameterTypes(),new Class<?>[]{net.minecraftforge.client.event.ModelRegistryEvent.class})){check(Modifier.isStatic(m.getModifiers()),"native subscribed handler static");m.invoke(null,new net.minecraftforge.client.event.ModelRegistryEvent());count++;}
  check(count==1,"one native model-registry subscriber");
 }
 static IBakedModel bake(ResourceLocation id,boolean item,TextureAtlasSprite base,TextureAtlasSprite overlay)throws Exception{
  net.minecraftforge.client.model.IModel model=net.minecraftforge.client.model.ModelLoaderRegistry.getModel(id);check(model!=net.minecraftforge.client.model.ModelLoaderRegistry.getMissingModel(),"actual custom loader, never missing placeholder: "+id);
  check(model.getDependencies().isEmpty(),"no fabricated model dependencies");Set<ResourceLocation> textures=new HashSet<>(Arrays.asList(new ResourceLocation(base.getIconName()),new ResourceLocation(overlay.getIconName())));check(new HashSet<ResourceLocation>(model.getTextures()).equals(textures),"exact base and overlay atlas dependencies "+id);
  Set<ResourceLocation> requested=new HashSet<>();IBakedModel baked=model.bake(model.getDefaultState(),item?DefaultVertexFormats.ITEM:DefaultVertexFormats.BLOCK,r->{check(textures.contains(r),"real bake requested original texture");requested.add(r);return r.toString().equals(base.getIconName())?base:overlay;});check(requested.equals(textures),"real bake requests both original sprites");return baked;
 }
 static final class ChangedObjPack implements IResourcePack {
  final IResourcePack original;ChangedObjPack(IResourcePack p){original=p;}
  public InputStream getInputStream(ResourceLocation id)throws IOException{
   if(!id.equals(new ResourceLocation("hbm","models/blocks/pipe_neo.obj")))return original.getInputStream(id);
   ByteArrayOutputStream b=new ByteArrayOutputStream();try(InputStream in=original.getInputStream(id)){byte[] data=new byte[4096];int n;while((n=in.read(data))!=-1)b.write(data,0,n);}
   String[] lines=new String(b.toByteArray(),StandardCharsets.UTF_8).split("\\n");StringBuilder changed=new StringBuilder();
   for(String line:lines){if(line.startsWith("v ")){String[] p=line.trim().split("\\s+");line="v "+(Float.parseFloat(p[1])+.0625F)+" "+p[2]+" "+p[3];}changed.append(line).append('\n');}
   return new ByteArrayInputStream(changed.toString().getBytes(StandardCharsets.UTF_8));
  }
  public boolean resourceExists(ResourceLocation id){return original.resourceExists(id);}public Set<String> getResourceDomains(){return original.getResourceDomains();}
  public <T extends net.minecraft.client.resources.data.IMetadataSection>T getPackMetadata(net.minecraft.client.resources.data.MetadataSerializer m,String k)throws IOException{return original.getPackMetadata(m,k);}
  public java.awt.image.BufferedImage getPackImage()throws IOException{return original.getPackImage();}public String getPackName(){return "Controlled translated original duct OBJ";}
 }

 static void registry(IResourcePack pack,Map<String,List<Face>> original)throws Exception{
  if(sharedResources==null){Field f=sun.misc.Unsafe.class.getDeclaredField("theUnsafe");f.setAccessible(true);unsafe=(sun.misc.Unsafe)f.get(null);sharedResources=new SimpleReloadableResourceManager(new net.minecraft.client.resources.data.MetadataSerializer());net.minecraft.client.Minecraft minecraft=(net.minecraft.client.Minecraft)unsafe.allocateInstance(net.minecraft.client.Minecraft.class);set(null,net.minecraft.client.Minecraft.class,"instance",minecraft);set(minecraft,net.minecraft.client.Minecraft.class,"resourceManager",sharedResources);}
  sharedResources.reloadResources(Collections.singletonList(pack));net.minecraft.launchwrapper.Launch.blackboard=new HashMap<String,Object>();net.minecraft.launchwrapper.Launch.blackboard.put("fml.deobfuscatedEnvironment",Boolean.TRUE);
  TextureMap atlas=new TextureMap("textures");ModelManager loaderManager=new ModelManager(atlas);net.minecraft.client.renderer.BlockModelShapes shapes=new net.minecraft.client.renderer.BlockModelShapes(loaderManager);
  new net.minecraftforge.client.model.ModelLoader(sharedResources,atlas,shapes);event();sharedResources.reloadResources(Collections.singletonList(pack));net.minecraftforge.client.model.ModelLoaderRegistry.clearModelCache(sharedResources);
  Map<?,?> custom=(Map<?,?>)get(null,net.minecraftforge.client.model.ModelLoader.class,"customModels");check(custom.size()==16,"all sixteen ItemBlock metadata registrations");
  net.minecraftforge.client.model.ModelLoader.onRegisterAllBlocks(shapes);net.minecraft.util.registry.RegistrySimple<ModelResourceLocation,IBakedModel> baked=new net.minecraft.util.registry.RegistrySimple<>();
  Map<IBlockState,ModelResourceLocation> mapping=shapes.getBlockStateMapper().getVariants(duct);check(mapping.size()==16,"native state mapper covers sixteen persisted metadata states");check(new HashSet<ModelResourceLocation>(mapping.values()).size()==16,"native state mapper preserves metadata for original skin selection");
  ResourceLocation json=new ResourceLocation("hbm","blockstates/"+duct.getRegistryName().getPath()+".json");ModelBlockDefinition definition;try(Reader r=new InputStreamReader(pack.getInputStream(json),StandardCharsets.UTF_8)){definition=ModelBlockDefinition.parseFromReader(r,duct.getRegistryName());}
  for(int meta=0;meta<16;meta++){
   TextureAtlasSprite base=sprite(meta,false),overlay=sprite(meta,true);IBlockState state=duct.getStateFromMeta(meta);ModelResourceLocation mapped=mapping.get(state);check(mapped.getVariant().equals("metadata="+meta),"actual native metadata state name");check(definition.hasVariant(mapped.getVariant()),"exact packaged blockstate variant exists");
   List<Variant> variants=definition.getVariant(mapped.getVariant()).getVariantList();check(variants.size()==1,"one native duct world model per state");Variant variant=variants.get(0);check(variant.getRotation()==ModelRotation.X0_Y0&&!variant.isUvLock(),"no unintended model or UV rotation");
   check(variant.getModelLocation().getPath().endsWith("native_fluid_duct/"+(meta%3)+"/world"),"rectified original skin path");IBakedModel model=bake(variant.getModelLocation(),false,base,overlay);baked.putObject(mapped,model);
   for(int mask=0;mask<64;mask++){int color=COLORS[mask%COLORS.length];geometry(model.getQuads(state(meta,mask,color),null,0),oracle(original,mask,false,color,base,overlay),false,"native loaded metadata="+meta+" mask="+mask);}
   for(String prefix:new String[]{"","block/"}){IBakedModel route=bake(new ResourceLocation("hbm",prefix+"native_fluid_duct/"+meta+"/world"),false,base,overlay);geometry(route.getQuads(null,null,0),oracle(original,0,false,0xff00ff,base,overlay),false,"loader normalized prefix "+prefix+" metadata "+meta);}
   Item item=Item.getItemFromBlock(duct);ModelResourceLocation id=(ModelResourceLocation)custom.get(org.apache.commons.lang3.tuple.Pair.of(item.delegate,meta));check(id!=null,"real item registration metadata "+meta);check(id.getPath().equals("native_fluid_duct/"+(meta%3)+"/item"),"rectified native item skin identity");IBakedModel itemModel=bake(id,true,base,overlay);baked.putObject(id,itemModel);geometry(itemModel.getQuads(null,null,0),oracle(original,0,true,OriginalFluidOracle.NONE_COLOR,base,overlay),true,"native loaded inventory metadata="+meta);
   geometry(bake(new ResourceLocation("hbm","block/native_fluid_duct/"+meta+"/item"),true,base,overlay).getQuads(null,null,0),oracle(original,0,true,OriginalFluidOracle.NONE_COLOR,base,overlay),true,"explicit item metadata route="+meta);
  }
  ModelManager manager=(ModelManager)unsafe.allocateInstance(ModelManager.class);set(manager,ModelManager.class,"modelRegistry",baked);net.minecraft.client.renderer.ItemModelMesher mesher=new net.minecraft.client.renderer.ItemModelMesher(manager);net.minecraftforge.client.model.ModelLoader.onRegisterItems(mesher);mesher.rebuildCache();
  for(int meta=0;meta<16;meta++){Item item=Item.getItemFromBlock(duct);ModelResourceLocation id=(ModelResourceLocation)custom.get(org.apache.commons.lang3.tuple.Pair.of(item.delegate,meta));check(mesher.getItemModel(new ItemStack(item,1,meta))==baked.getObject(id),"actual native ItemModelMesher route metadata "+meta);}
  TextureAtlasSprite base=sprite(0,false),overlay=sprite(0,true);ResourceLocation id=new ResourceLocation("hbm","native_fluid_duct/0/world");net.minecraftforge.client.model.IModel old=net.minecraftforge.client.model.ModelLoaderRegistry.getModel(id);IBakedModel oldBaked=bake(id,false,base,overlay);List<BakedQuad> oldQuads=oldBaked.getQuads(null,null,0);float before=Float.intBitsToFloat(oldQuads.get(0).getVertexData()[0]);
  sharedResources.reloadResources(Collections.singletonList(new ChangedObjPack(pack)));net.minecraftforge.client.model.ModelLoaderRegistry.clearModelCache(sharedResources);
  check(net.minecraftforge.client.model.ModelLoaderRegistry.getModel(id)!=old,"resource reload invalidates unbaked cache");IBakedModel fresh=bake(id,false,base,overlay);check(fresh!=oldBaked,"resource reload produces fresh baked model");close(Float.intBitsToFloat(fresh.getQuads(null,null,0).get(0).getVertexData()[0]),before+.0625F,"reload reparses changed original OBJ");close(Float.intBitsToFloat(oldQuads.get(0).getVertexData()[0]),before,"reload never mutates retained original list");
  sharedResources.reloadResources(Collections.singletonList(pack));net.minecraftforge.client.model.ModelLoaderRegistry.clearModelCache(sharedResources);close(Float.intBitsToFloat(bake(id,false,base,overlay).getQuads(null,null,0).get(0).getVertexData()[0]),before,"reload restores original OBJ");
 }
