public final class BulletNativeTest {
 static int checks,vertices,originalTessVertices,sharedMeshVertices,pixels;static void check(boolean ok,String why){checks++;if(!ok)throw new AssertionError(why);}
 static Field field(Class<?> type,String name)throws Exception{Field f=type.getDeclaredField(name);f.setAccessible(true);return f;}
 static final List<Batch> draws=new ArrayList<>();static boolean recording=true;
 static final class Batch {
  int mode,count;boolean color,normal,uv,legacy;int[][] data;float[] matrix,currentColor;int[] state;
  Batch(){matrix=NativeMachineItemTest.matrix();FloatBuffer f=org.lwjgl.BufferUtils.createFloatBuffer(16);GL11.glGetFloat(GL11.GL_CURRENT_COLOR,f);currentColor=new float[4];f.get(currentColor);state=state();}
 }
 static int[] state(){return new int[]{GL11.glIsEnabled(GL11.GL_CULL_FACE)?1:0,GL11.glIsEnabled(GL11.GL_LIGHTING)?1:0,GL11.glIsEnabled(GL11.GL_TEXTURE_2D)?1:0,GL11.glIsEnabled(GL11.GL_BLEND)?1:0,GL11.glGetInteger(GL11.GL_BLEND_SRC),GL11.glGetInteger(GL11.GL_BLEND_DST),GL11.glGetBoolean(GL11.GL_DEPTH_WRITEMASK)?1:0,GL11.glGetInteger(GL11.GL_SHADE_MODEL),GL11.glGetInteger(GL11.GL_ALPHA_TEST_FUNC),Float.floatToIntBits(GL11.glGetFloat(GL11.GL_ALPHA_TEST_REF)),GL11.glIsEnabled(org.lwjgl.opengl.GL12.GL_RESCALE_NORMAL)?1:0,Float.floatToIntBits(GL11.glGetFloat(GL11.GL_LINE_WIDTH))};}
 static final class Capture extends Tessellator {
  Capture(){super(2097152);}
  @Override public void draw(){if(recording){BufferBuilder b=getBuffer();VertexFormat fmt=b.getVertexFormat();Batch out=new Batch();out.mode=b.getDrawMode();out.count=b.getVertexCount();out.color=fmt.hasColor();out.normal=fmt.hasNormal();out.uv=fmt.hasUvOffset(0);out.data=new int[out.count][8];ByteBuffer buf=b.getByteBuffer().duplicate().order(ByteOrder.nativeOrder());buf.clear();
   for(int i=0;i<out.count;i++){int pos=i*fmt.getSize();for(int c=0;c<3;c++)out.data[i][c]=buf.getInt(pos+c*4);if(out.uv){out.data[i][3]=buf.getInt(pos+fmt.getUvOffsetById(0));out.data[i][4]=buf.getInt(pos+fmt.getUvOffsetById(0)+4);}if(out.color)out.data[i][5]=buf.getInt(pos+fmt.getColorOffset());if(out.normal){int n=pos+fmt.getNormalOffset();out.data[i][6]=(buf.get(n)&255)|(buf.get(n+1)&255)<<8|(buf.get(n+2)&255)<<16;}}draws.add(out);}super.draw();}
 }
 static void legacyCapture(){if(!recording)return;Batch out=new Batch();out.legacy=true;out.count=(Integer)LegacyTess.field("g");out.mode=(Integer)LegacyTess.field("s");out.color=(Boolean)LegacyTess.field("l");out.normal=(Boolean)LegacyTess.field("o");out.uv=(Boolean)LegacyTess.field("m");int[] raw=(int[])LegacyTess.field("f");out.data=new int[out.count][8];for(int i=0;i<out.count;i++){System.arraycopy(raw,i*8,out.data[i],0,7);out.data[i][6]&=0xFFFFFF;}draws.add(out);}
 static void installCapture()throws Exception{Field f=field(Tessellator.class,"INSTANCE");Field mods=field(Field.class,"modifiers");mods.setInt(f,f.getModifiers()&~Modifier.FINAL);f.set(null,new Capture());LegacyTess.capture=BulletNativeTest::legacyCapture;}
 static void reset(){NativeMachineDrawTest.reset(); // Synchronize every state touched by original raw GL as well as native cached calls.
  GL11.glDisable(GL11.GL_CULL_FACE);GlStateManager.disableCull();GL11.glDisable(GL11.GL_LIGHTING);GlStateManager.disableLighting();GL11.glEnable(GL11.GL_TEXTURE_2D);GlStateManager.enableTexture2D();GL11.glDisable(GL11.GL_BLEND);GlStateManager.disableBlend();GL11.glBlendFunc(GL11.GL_SRC_ALPHA,GL11.GL_ONE_MINUS_SRC_ALPHA);GlStateManager.blendFunc(GL11.GL_SRC_ALPHA,GL11.GL_ONE_MINUS_SRC_ALPHA);GL11.glDepthMask(true);GlStateManager.depthMask(true);GL11.glShadeModel(GL11.GL_FLAT);GlStateManager.shadeModel(GL11.GL_FLAT);GL11.glAlphaFunc(GL11.GL_GREATER,.1F);GlStateManager.alphaFunc(GL11.GL_GREATER,.1F);GL11.glEnable(GL11.GL_ALPHA_TEST);GlStateManager.enableAlpha();GL11.glDisable(org.lwjgl.opengl.GL12.GL_RESCALE_NORMAL);GlStateManager.disableRescaleNormal();GL11.glColor4f(1,1,1,1);GlStateManager.color(1,1,1,1);GL11.glLineWidth(1);
  GL11.glTranslatef(32,32,0);GL11.glScalef(7,7,7);GL11.glRotatef(15,1,0,0);GL11.glRotatef(25,0,1,0);draws.clear();
 }
 static void equal(List<Batch> expected,List<Batch> actual,String label){check(expected.size()==actual.size(),label+" draw count "+expected.size()+" != "+actual.size());for(int d=0;d<expected.size();d++){Batch e=expected.get(d),a=actual.get(d);check(e.mode==a.mode&&e.count==a.count&&(e.count==0||e.color==a.color&&e.normal==a.normal&&e.uv==a.uv),label+" primitive/format "+d);check(Arrays.equals(e.matrix,a.matrix),label+" exact matrix "+d);check(Arrays.equals(e.state,a.state),label+" GL state "+d+" "+Arrays.toString(e.state)+" != "+Arrays.toString(a.state));if(e.count>0&&!e.color)check(Arrays.equals(e.currentColor,a.currentColor),label+" current material RGBA "+d);for(int v=0;v<e.count;v++){vertices++;if(e.legacy)originalTessVertices++;else sharedMeshVertices++;for(int c=0;c<7;c++)if(c<3||c<5&&e.uv||c==5&&e.color||c==6&&e.normal)check(e.data[v][c]==a.data[v][c],label+" vertex/attribute "+d+":"+v+":"+c+" "+e.data[v][c]+" != "+a.data[v][c]);}}}
 static void compare(Runnable original,Runnable nativeDraw,String label){reset();original.run();List<Batch> before=new ArrayList<>(draws);byte[] expected=NativeMachineDrawTest.pixels();int[] post=state();reset();nativeDraw.run();equal(before,new ArrayList<>(draws),label);byte[] actual=NativeMachineDrawTest.pixels();check(Arrays.equals(expected,actual),label+" real framebuffer");pixels+=64*64;check(Arrays.equals(post,state()),label+" final GL state");check(GL11.glGetError()==0,label+" no GL error");check(GL11.glGetInteger(GL11.GL_MODELVIEW_STACK_DEPTH)==1,label+" matrix balance");}
 static void invoke(Object object,String name,Class<?>[] types,Object...args){try{Method m=object.getClass().getDeclaredMethod(name,types);m.setAccessible(true);m.invoke(object,args);}catch(InvocationTargetException e){throw new RuntimeException(e.getCause());}catch(Exception e){throw new RuntimeException(e);}}
 static EntityBulletBaseNT bullet(int style,int trail,int id,int ticks){EntityBulletBaseNT b=new EntityBulletBaseNT();b.setConfig(331,style,trail);b.setEntityId(id);b.prevRotationYaw=12;b.rotationYaw=29;b.prevRotationPitch=-31;b.rotationPitch=-42;b.ticksExisted=ticks;b.prevPosX=1.25;b.posX=3.75;b.prevPosY=2.125;b.posY=3.5;b.prevPosZ=-4.75;b.posZ=-2.25;return b;}
 static void sync()throws Exception{
  EntityBulletBaseNT a=new EntityBulletBaseNT(),b=new EntityBulletBaseNT();check(a.getRenderStyle()==0&&a.getRenderTrail()==0&&a.configId()==0&&a.getStuckIn()==0,"original initial all-zero values, including stuck=0 not -1");
  List<EntityDataManager.DataEntry<?>> all=a.getDataManager().getAll();Set<Integer> ids=new HashSet<>();for(EntityDataManager.DataEntry<?> e:all)check(ids.add(e.getKey().getId()),"native inherited watcher IDs do not collide");
  for(int[] v:new int[][]{{-1,-1,-1,-1},{19,6,218738,5},{255,128,Integer.MAX_VALUE,255},{-128,-129,Integer.MIN_VALUE,-128},{0,0,0,0}}){a.setConfig(v[2],v[0],v[1]);a.setStuckIn(v[3]);PacketBuffer wire=new PacketBuffer(io.netty.buffer.Unpooled.buffer());a.getDataManager().writeEntries(wire);b.getDataManager().setEntryValues(EntityDataManager.readEntries(wire));check(b.getRenderStyle()==(byte)v[0]&&b.getRenderTrail()==(byte)v[1]&&b.configId()==v[2]&&b.getStuckIn()==(byte)v[3],"actual native spawn-metadata encode/decode signed-byte/varint values");wire.release();List<EntityDataManager.DataEntry<?>> dirty=a.getDataManager().getDirty();if(dirty!=null){PacketBuffer update=new PacketBuffer(io.netty.buffer.Unpooled.buffer());EntityDataManager.writeEntries(dirty,update);b.getDataManager().setEntryValues(EntityDataManager.readEntries(update));update.release();check(!a.getDataManager().isDirty(),"native incremental metadata dirty state consumed");}}
  check(!a.writeToNBTOptional(new NBTTagCompound()),"original save omission unchanged");a.readEntityFromNBT(new NBTTagCompound());check(a.isDead,"original loaded bullet is discarded, no new configuration persistence");
 }
 static void modelBullet()throws Exception{
  ClassLoader loader=LegacyTess.type.getClassLoader();Class<?> base=Class.forName("bhr",true,loader),renderer=Class.forName("bix",true,loader);Object oldBase=Class.forName("bhi",true,loader).newInstance();base.getField("t").setInt(oldBase,8);base.getField("u").setInt(oldBase,4);Object old=renderer.getConstructor(base,int.class,int.class).newInstance(oldBase,0,0);
  renderer.getMethod("a",float.class,float.class,float.class,int.class,int.class,int.class).invoke(old,0F,0F,0F,2,1,1);renderer.getMethod("a",float.class,float.class,float.class).invoke(old,1F,-.5F,-.5F);renderer.getMethod("b",int.class,int.class).invoke(old,8,4);renderer.getField("i").setBoolean(old,true);
  com.hbm.render.model.ModelBullet model=new com.hbm.render.model.ModelBullet();net.minecraft.client.model.ModelRenderer nativePart=(net.minecraft.client.model.ModelRenderer)field(com.hbm.render.model.ModelBullet.class,"bullet").get(model);
  Object oldBox=((List<?>)renderer.getField("l").get(old)).get(0);Object[] quads=(Object[])field(oldBox.getClass(),"i").get(oldBox);net.minecraft.client.model.TexturedQuad[] current=(net.minecraft.client.model.TexturedQuad[])field(net.minecraft.client.model.ModelBox.class,"quadList").get(nativePart.cubeList.get(0));check(quads.length==current.length,"actual original/native ModelBullet box face count");
  for(int q=0;q<quads.length;q++){Object[] oldVertices=(Object[])quads[q].getClass().getField("a").get(quads[q]);for(int v=0;v<4;v++){Object oldVector=oldVertices[v].getClass().getField("a").get(oldVertices[v]);net.minecraft.client.model.PositionTextureVertex actual=current[q].vertexPositions[v];check(oldVector.getClass().getField("a").getDouble(oldVector)==actual.vector3D.x&&oldVector.getClass().getField("b").getDouble(oldVector)==actual.vector3D.y&&oldVector.getClass().getField("c").getDouble(oldVector)==actual.vector3D.z,"24 actual old/native model cube vertex coordinates/order");check(oldVertices[v].getClass().getField("b").getFloat(oldVertices[v])==actual.texturePositionX&&oldVertices[v].getClass().getField("c").getFloat(oldVertices[v])==actual.texturePositionY,"24 actual old/native model cube UVs, texture size and post-add mirror quirk");}}
  Method render=renderer.getMethod("a",float.class);for(String texture:new String[]{"emplacer","tau"}){ResourceLocation material=new ResourceLocation("hbm:textures/models/"+texture+".png");reset();GL11.glScalef(16,16,16);NativeMachineDrawTest.textures.bindTexture(material);render.invoke(old,.0625F);byte[] before=NativeMachineDrawTest.pixels();check(!Arrays.equals(before,new byte[64*64*4]),"actual original ModelBullet draws nonempty pixels "+texture);int[] post=state();reset();GL11.glScalef(16,16,16);NativeMachineDrawTest.textures.bindTexture(material);model.renderAll(.0625F);check(Arrays.equals(before,NativeMachineDrawTest.pixels()),"actual original ModelRenderer/display-list/Tessellator cube versus native model framebuffer "+texture);check(Arrays.equals(post,state()),"old/native model outgoing GL state "+texture);check(GL11.glGetError()==0,"old/native ModelBullet no GL error");pixels+=4096;}
 }
 static void helpers(){
  for(int seed:new int[]{0,1,37,-611,Integer.MAX_VALUE})for(int max:new int[]{1,2,3})compare(()->OriginalSparks.renderSpark(seed,.2,-.1,.5,.75F,2,max,0x8050FF,0xFF2030),()->RenderSparks.renderSpark(seed,.2,-.1,.5,.75F,2,max,0x8050FF,0xFF2030),"spark "+seed+"/"+max);
  for(int wave=0;wave<2;wave++)for(int beam=0;beam<2;beam++)for(float alpha:new float[]{0,.25F,1,256})for(boolean depth:new boolean[]{false,true}){final int w=wave,t=beam;Vec3d vec=new Vec3d(.5,3,-.75);compare(()->{if(depth)OriginalBeam.prontBeamwithDepth(vec,OriginalBeam.EnumWaveType.values()[w],OriginalBeam.EnumBeamType.values()[t],0xA015FE,0xE4D0AB,13,3,.4F,3,.17F,alpha);else OriginalBeam.prontBeam(vec,OriginalBeam.EnumWaveType.values()[w],OriginalBeam.EnumBeamType.values()[t],0xA015FE,0xE4D0AB,13,3,.4F,3,.17F,alpha);},()->{if(depth)BeamPronter.prontBeamwithDepth(vec,BeamPronter.EnumWaveType.values()[w],BeamPronter.EnumBeamType.values()[t],0xA015FE,0xE4D0AB,13,3,.4F,3,.17F,alpha);else BeamPronter.prontBeam(vec,BeamPronter.EnumWaveType.values()[w],BeamPronter.EnumBeamType.values()[t],0xA015FE,0xE4D0AB,13,3,.4F,3,.17F,alpha);},"beam "+wave+beam+alpha+depth);}
  // Callers still using raw GL must not defeat a cached helper state update.
  Runnable beam=()->BeamPronter.prontBeam(new Vec3d(0,3,0),BeamPronter.EnumWaveType.SPIRAL,BeamPronter.EnumBeamType.SOLID,0xFF9000,0xFF9000,0,1,0,6,.04F,256);
  reset();beam.run();GL11.glEnable(GL11.GL_CULL_FACE);GL11.glBlendFunc(GL11.GL_SRC_ALPHA,GL11.GL_ONE_MINUS_SRC_ALPHA);GL11.glDisable(GL11.GL_TEXTURE_2D);GL11.glDisable(GL11.GL_LIGHTING);draws.clear();beam.run();for(Batch d:draws)check(d.state[0]==0&&d.state[1]==0&&d.state[2]==0&&d.state[4]==GL11.GL_SRC_ALPHA&&d.state[5]==GL11.GL_ONE,"raw-GL caller state cannot defeat native helper cull/blend sync");check(GL11.glIsEnabled(GL11.GL_TEXTURE_2D)&&GL11.glIsEnabled(GL11.GL_LIGHTING),"raw-state helper exit re-enables texture/lighting");
 }
 static void projectiles(RenderBullet renderer,OriginalBullet old){
  for(int trail:new int[]{-1,0,1,2,3,4,5,6,7})for(int id:new int[]{1,73,-233}){EntityBulletBaseNT b=bullet(BulletConfiguration.STYLE_BOLT,trail,id,4);compare(()->old.doRender(b,.2,.3,-.4,94,.375F),()->renderer.doRender(b,.2,.3,-.4,94,.375F),"bolt "+trail+"/"+id);}
  // Actual shared mesh implementations load and draw every old model path.
  for(int style:new int[]{-1,0,1,2,3,5,6,7,10,11,13,14,18,19,127})for(int trail:new int[]{0,1,2,5})for(int stuck:new int[]{-1,0,5}){EntityBulletBaseNT b=bullet(style,trail,179,4);b.setStuckIn(stuck);recording=false;reset();old.doRender(b,.2,.3,-.4,0,.375F);reset();renderer.doRender(b,.2,.3,-.4,0,.375F);recording=true;compare(()->old.doRender(b,.2,.3,-.4,0,.375F),()->renderer.doRender(b,.2,.3,-.4,0,.375F),"style "+style+"/"+trail+"/"+stuck);}
  for(int trail:new int[]{0,1,2})for(int ticks:new int[]{0,1,4,5,9,10,50})for(boolean initial:new boolean[]{false,true}){EntityBulletBaseNT a=bullet(17,trail,71,ticks),b=bullet(17,trail,71,ticks);for(EntityBulletBaseNT e:new EntityBulletBaseNT[]{a,b}){e.px=-.5;e.py=initial?0:7;e.pz=1.125;e.trail.add(new Pair<>(new Vec3d(0,0,0),1D));e.trail.add(new Pair<>(new Vec3d(-1,.25,.75),.75D));e.trail.add(new Pair<>(new Vec3d(-2,.1,1.25),.4D));e.trail.add(new Pair<>(new Vec3d(-3,-.1,.5),0D));e.trail.add(new Pair<>(new Vec3d(-4,.1,-.25),0D));}compare(()->old.doRender(a,.2,.3,-.4,0,.375F),()->renderer.doRender(b,.2,.3,-.4,0,.375F),"tau "+trail+"/"+ticks+"/"+initial);check(a.px==b.px&&a.py==b.py&&a.pz==b.pz,"exact previous render coordinates");for(int i=0;i<a.trail.size();i++)check(a.trail.get(i).key.equals(b.trail.get(i).key)&&a.trail.get(i).value.equals(b.trail.get(i).value),"all Tau nodes relocated identically, including zero-alpha suffix");}
  // Source's millisecond seed is intentionally unchanged. Compare an ORB frame
  // only when both real invocations occur within the same 100 ms seed window.
  for(int trail:new int[]{0,1,2}){EntityBulletBaseNT b=bullet(12,trail,71,4);boolean same=false;for(int attempt=0;attempt<50&&!same;attempt++){long start=System.currentTimeMillis()/100;reset();old.doRender(b,0,0,0,0,.5F);List<Batch> before=new ArrayList<>(draws);byte[] pix=NativeMachineDrawTest.pixels();int[] post=state();reset();renderer.doRender(b,0,0,0,0,.5F);if(start==System.currentTimeMillis()/100){equal(before,new ArrayList<>(draws),"orb "+trail);check(Arrays.equals(pix,NativeMachineDrawTest.pixels()),"orb real framebuffer "+trail);pixels+=4096;check(Arrays.equals(post,state()),"orb final GL "+trail);same=true;}}check(same,"same-time orb oracle comparison completed");}
 }
 static final class Frame extends NativeMachineDrawTest.BaseOwner implements NativeMachineItemRenderer.FrameItemModel {EntityItem item;float[] matrix;NativeMachineItemRenderer.Display display;int calls;Frame(){super(NativeMachineDrawTest.icon);}public void renderFrame(EntityItem item,double x,double y,double z,float yaw,float partial,NativeMachineItemRenderer.Display display){this.item=item;matrix=NativeMachineItemTest.matrix();this.display=display;calls++;check(x==0&&y==0&&z==0&&yaw==0&&partial==0,"original blade nested arguments");}}
 static void blade(RenderBullet renderer){Frame frame=new Frame();NativeMachineDrawTest.model(com.hbm.items.ModItems.blade_titanium,frame);EntityBulletBaseNT b=bullet(15,0,211,4);for(int id:new int[]{0,1,137}){b.setEntityId(id);reset();float[] prior=NativeMachineItemTest.matrix();long start=System.currentTimeMillis();renderer.doRender(b,.2,.3,-.4,0,.375F);long end=System.currentTimeMillis();check(Arrays.equals(prior,NativeMachineItemTest.matrix()),"blade restores outer transform");check(frame.item.getItem().getCount()==1&&frame.item.getItem().getItem()==com.hbm.items.ModItems.blade_titanium&&frame.item.hoverStart==0&&frame.item.getAge()==0,"blade original item/count/age/hover");check(frame.display==NativeMachineItemRenderer.Display.ENTITY_FRAME,"blade uses ordinary frame count/bob path, not decoration");boolean found=false;for(long ms=start;ms<=end;ms++){reset();GL11.glTranslatef(.2F,.3F,-.4F);GL11.glRotatef(12+(29-12)*.375F-90,0,1,0);GL11.glRotatef(-31+(-42+31)*.375F+180,0,0,1);GL11.glScalef(1.5F,1.5F,1.5F);GL11.glRotated(90,0,0,1);GL11.glTranslated(0,.5,0);GL11.glRotated(ms%360,1,0,0);GL11.glTranslated(0,-.5,0);GL11.glRotated(90,0,1,0);GL11.glScaled(1,2,1);if(Arrays.equals(frame.matrix,NativeMachineItemTest.matrix()))found=true;}check(found,"blade original transform and wall-clock spin, no randomized ID roll");}
  try {
   java.awt.image.BufferedImage png=javax.imageio.ImageIO.read(new java.io.File(resourcesPath,"assets/hbm/textures/items/blade_titanium.png"));int w=png.getWidth(),h=png.getHeight();int[] rgba=png.getRGB(0,0,w,h,null,0,w);
   net.minecraft.client.renderer.texture.DynamicTexture texture=new net.minecraft.client.renderer.texture.DynamicTexture(png);NativeMachineDrawTest.textures.loadTexture(net.minecraft.client.renderer.texture.TextureMap.LOCATION_BLOCKS_TEXTURE,texture);
   net.minecraft.client.renderer.texture.TextureAtlasSprite sprite=new net.minecraft.client.renderer.texture.TextureAtlasSprite("hbm:blade_titanium"){};sprite.setIconWidth(w);sprite.setIconHeight(h);sprite.initSprite(w,h,0,0,false);sprite.setFramesTextureData(Collections.singletonList(new int[][]{rgba}));
   NativeMachineDrawTest.icon=new net.minecraftforge.client.model.BakedItemModel(com.google.common.collect.ImmutableList.copyOf(net.minecraftforge.client.model.ItemLayerModel.getQuadsForSprite(-1,sprite,DefaultVertexFormats.ITEM,Optional.empty())),sprite,com.google.common.collect.ImmutableMap.of(),net.minecraft.client.renderer.block.model.ItemOverrideList.NONE);
   check(NativeMachineItemTest.model(net.minecraftforge.client.model.ItemLayerModel.getQuadsForSprite(-1,sprite,DefaultVertexFormats.ITEM,Optional.empty()),sprite)!=null,"actual blade PNG generates native full icon model");
  }catch(Exception e){throw new RuntimeException(e);}
  NativeMachineDrawTest.model(com.hbm.items.ModItems.blade_titanium,NativeMachineDrawTest.icon);for(boolean fancy:new boolean[]{false,true}){NativeMachineDrawTest.mc.gameSettings.fancyGraphics=fancy;reset();renderer.doRender(b,0,0,0,0,.5F);check(!Arrays.equals(NativeMachineDrawTest.pixels(),new byte[64*64*4]),"actual blade native icon/frame raster "+fancy);check(GL11.glGetError()==0,"blade no GL error");}
 }
 static String resourcesPath;
 static void assets(String path)throws Exception{resourcesPath=path;
  SimpleReloadableResourceManager r=(SimpleReloadableResourceManager)NativeMachineDrawTest.mc.getResourceManager();r.reloadResourcePack(new FolderResourcePack(new java.io.File(path)));
  ResourceManager.projectiles.delegate=new HFRWavefrontObject(r,new ResourceLocation("hbm:models/projectiles/projectiles.obj"),false);ResourceManager.leadburster.delegate=new HFRWavefrontObject(r,new ResourceLocation("hbm:models/projectiles/leadburster.obj"),false);ResourceManager.sphere_uv.delegate=new ObjMeshModel(r,new ResourceLocation("hbm:models/sphere_uv.obj"));ResourceManager.meteor.delegate=new ObjMeshModel(r,new ResourceLocation("hbm:models/weapons/meteor.obj"));
  // Real source declarations are injected into this block by the runner.
  /*TEXTURE_DECLARATIONS*/
  for(String group:new String[]{"BulletRifle","BulletPistol","Buckshot","Rocket","Grenade","Flechette"})check(!ResourceManager.projectiles.delegate.getMesh().selectParts(group).isEmpty(),"actual projectile group exists "+group);for(String group:new String[]{"Based","Based.001","Backlight"})check(!ResourceManager.leadburster.delegate.getMesh().selectParts(group).isEmpty(),"actual leadburster group exists "+group);
 }
 public static void main(String[] args)throws Exception{
