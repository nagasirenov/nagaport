/** Complete production classes, original-source recorder and independent OBJ parser. */
public final class CableNativeTest {
 static int checks; static final BlockPos POS=new BlockPos(8,64,8);
 static BlockCable modern,classic;
 static final class Sprite extends TextureAtlasSprite {
  Sprite(String name,int index){super(name);setIconWidth(16);setIconHeight(16);initSprite(512,128,16*index,32,false);}
 }
 static void check(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
 static void close(float got,float want,String message){check(Math.abs(got-want)<0.000003F,message+": "+got+" != "+want);}
 static void register(Block block,String name){block.setTranslationKey(name);ForgeRegistries.BLOCKS.register(block.setRegistryName("hbm","tile."+name));ForgeRegistries.ITEMS.register(new ItemBlock(block).setRegistryName(block.getRegistryName()));}
 static void setup(){modern=new BlockCable(Material.IRON);classic=new BlockCable(Material.IRON);register(modern,"red_cable");register(classic,"red_cable_classic");ModBlocks.red_cable=modern;ModBlocks.red_cable_classic=classic;}
 static final class Face {String group;float[][] xyz,uv;float[] normal;}
 static Map<String,List<Face>> originalObj(Reader source)throws Exception{
  List<float[]> points=new ArrayList<>(),uvs=new ArrayList<>();Map<String,List<Face>> groups=new LinkedHashMap<>();BufferedReader in=new BufferedReader(source);String line,group=null;
  while((line=in.readLine())!=null){String[] p=line.trim().split("\\s+");if(p[0].equals("o")||p[0].equals("g")){group=p[1];groups.put(group,new ArrayList<>());}
   else if(p[0].equals("v"))points.add(new float[]{Float.parseFloat(p[1]),Float.parseFloat(p[2]),Float.parseFloat(p[3])});
   else if(p[0].equals("vt"))uvs.add(new float[]{Float.parseFloat(p[1]),1-Float.parseFloat(p[2])});
   else if(p[0].equals("f")){check(p.length==4||p.length==5,"original triangle/quad primitive");Face f=new Face();f.group=group;f.xyz=new float[p.length-1][];f.uv=new float[p.length-1][];
    for(int i=1;i<p.length;i++){String[] k=p[i].split("/");f.xyz[i-1]=points.get(Integer.parseInt(k[0])-1);f.uv[i-1]=uvs.get(Integer.parseInt(k[1])-1);}
    double ax=f.xyz[1][0]-f.xyz[0][0],ay=f.xyz[1][1]-f.xyz[0][1],az=f.xyz[1][2]-f.xyz[0][2],bx=f.xyz[2][0]-f.xyz[0][0],by=f.xyz[2][1]-f.xyz[0][1],bz=f.xyz[2][2]-f.xyz[0][2];
    double nx=ay*bz-az*by,ny=az*bx-ax*bz,nz=ax*by-ay*bx,length=(float)Math.sqrt(nx*nx+ny*ny+nz*nz);
    f.normal=new float[]{(float)(nx/length),(float)(ny/length),(float)(nz/length)};groups.get(group).add(f);
   }
  }
  check(groups.keySet().equals(new LinkedHashSet<String>(Arrays.asList("negY","negX","negZ","posX","posY","Core","posZ","CZ","CX","CY"))),"exact original cable group set");return groups;
 }
 static List<OriginalCableOracle.Vertex[]> modernOracle(Map<String,List<Face>> source,int mask,boolean inventory,TextureAtlasSprite sprite){
  OriginalCableOracle.Recorder out=new OriginalCableOracle.Recorder(inventory,false);
  for(String group:OriginalCableOracle.modernGroups(mask,inventory))for(Face f:source.get(group)){
   float nx=f.normal[0],ny=f.normal[1],nz=f.normal[2];out.setNormal(inventory?-nx:nx,ny,inventory?-nz:nz);
   float shade=inventory?1:Math.max(.45F,ny*.3F+.7F-Math.abs(nx)*.1F+Math.abs(nz)*.1F);out.setColorOpaque_F(shade,shade,shade);
   for(int v=0;v<4;v++){int i=Math.min(v,f.xyz.length-1);float[] p=f.xyz[i],uv=f.uv[i];out.addVertexWithUV(p[0],p[1],p[2],sprite.getInterpolatedU(uv[0]*16D),sprite.getInterpolatedV(uv[1]*16D));}
  }
  return out.quads();
 }
 static void geometry(List<BakedQuad> actual,List<OriginalCableOracle.Vertex[]> expected,boolean inventory,TextureAtlasSprite sprite,String context){
  check(actual.size()==expected.size(),context+" pristine quad count "+actual.size()+" != "+expected.size());
  for(int i=0;i<actual.size();i++){
   BakedQuad q=actual.get(i);OriginalCableOracle.Vertex[] want=expected.get(i);check(q.getSprite()==sprite,context+" exact chosen sprite");
   check(q.shouldApplyDiffuseLighting()==inventory&&!q.hasTintIndex(),context+" native diffuse flag/no tint");
   check(q.getFormat().equals(inventory?DefaultVertexFormats.ITEM:DefaultVertexFormats.BLOCK),context+" native format");int[] bytes=q.getVertexData();check(bytes.length==28,context+" four native vertices");
   for(int v=0;v<4;v++){int k=7*v;OriginalCableOracle.Vertex e=want[v];String label=context+" quad"+i+" vertex"+v;
    close(Float.intBitsToFloat(bytes[k]),e.x,label+" original X");close(Float.intBitsToFloat(bytes[k+1]),e.y,label+" original Y");close(Float.intBitsToFloat(bytes[k+2]),e.z,label+" original Z");
    close(Float.intBitsToFloat(bytes[k+4]),e.u,label+" original U without contraction");close(Float.intBitsToFloat(bytes[k+5]),e.v,label+" original V without contraction");
    int c=bytes[k+3];check((c&255)==e.shade&&((c>>8)&255)==e.shade&&((c>>16)&255)==e.shade&&((c>>>24)&255)==255,label+" source truncated color bytes");
    if(inventory){int n=bytes[k+6];check((byte)n==(byte)(e.nx*127F)&&(byte)(n>>8)==(byte)(e.ny*127F)&&(byte)(n>>16)==(byte)(e.nz*127F),label+" original packed normal: "+Integer.toHexString(n));}
   }
  }
  try{actual.add(null);throw new AssertionError("mutable cable quad list");}catch(UnsupportedOperationException expectedFailure){checks++;}
 }
 static final class LightingWorld implements IBlockAccess {
  final IBlockState state;final int own=0x00A00070;
  LightingWorld(IBlockState state){this.state=state;}
  public TileEntity getTileEntity(BlockPos p){return null;}
  public int getCombinedLight(BlockPos p,int emission){return p.equals(POS)?own:0x00100010*((Math.abs(p.getX()+2*p.getY()+3*p.getZ())%8)+1);}
  public IBlockState getBlockState(BlockPos p){return p.equals(POS)?state:Blocks.STONE.getDefaultState();}
  public boolean isAirBlock(BlockPos p){return false;}
  public net.minecraft.world.biome.Biome getBiome(BlockPos p){return Biomes.PLAINS;}
  public int getStrongPower(BlockPos p,EnumFacing side){return 0;}
  public WorldType getWorldType(){return WorldType.DEFAULT;}
  public boolean isSideSolid(BlockPos p,EnumFacing side,boolean fallback){return !p.equals(POS);}
 }
 static void lighting(IBakedModel model,IBlockState state,String context){
  LightingWorld world=new LightingWorld(state);net.minecraft.client.renderer.color.BlockColors colors=new net.minecraft.client.renderer.color.BlockColors();List<BakedQuad> quads=model.getQuads(state,null,0);
  for(boolean forge:new boolean[]{false,true}){
   net.minecraft.client.renderer.BufferBuilder out=new net.minecraft.client.renderer.BufferBuilder(65536);out.begin(7,DefaultVertexFormats.BLOCK);
   if(forge){net.minecraftforge.client.model.pipeline.VertexLighterFlat lighter=new net.minecraftforge.client.model.pipeline.VertexLighterFlat(colors);
    net.minecraftforge.client.model.pipeline.VertexBufferConsumer consumer=new net.minecraftforge.client.model.pipeline.VertexBufferConsumer(out);consumer.setOffset(POS);lighter.setParent(consumer);lighter.setWorld(world);lighter.setState(state);lighter.setBlockPos(POS);lighter.updateBlockInfo();
    for(BakedQuad q:quads)q.pipe(lighter);lighter.resetBlockInfo();
   }else check(new net.minecraft.client.renderer.BlockModelRenderer(colors).renderModelFlat(world,model,state,POS,out,true,0),context+" native vanilla emits model");
   out.finishDrawing();check(out.getVertexCount()==quads.size()*4,context+" native emitted vertices "+forge);java.nio.ByteBuffer data=out.getByteBuffer();
   for(int v=0;v<out.getVertexCount();v++){
    check(data.getInt(v*28+24)==world.own,context+" "+(forge?"Forge":"vanilla")+" original block-position light, not neighbor at vertex "+v+": "+Integer.toHexString(data.getInt(v*28+24)));
    check(data.getInt(v*28+12)==quads.get(v/4).getVertexData()[v%4*7+3],context+" original gray shading without doubled diffuse "+forge);
   }
  }
 }
 static void direct(IResourcePack pack,Map<String,List<Face>> oracle)throws Exception{
  ObjMesh mesh;ResourceLocation obj=new ResourceLocation("hbm","models/blocks/cable_neo.obj");try(Reader r=new InputStreamReader(pack.getInputStream(obj),StandardCharsets.UTF_8)){mesh=ObjMeshParser.parse(r,obj.toString(),false);}
  for(boolean old:new boolean[]{false,true}){
   TextureAtlasSprite sprite=new Sprite("hbm:blocks/"+(old?"red_cable_classic":"cable_neo"),old?3:1);
   for(boolean item:new boolean[]{false,true}){
    IBakedModel model=new ConnectionBakedModel(mesh,old,item,sprite);
    check(!model.isAmbientOcclusion()&&model.isGui3d()&&!model.isBuiltInRenderer(),"native non-AO 3D cable model");check(model.getParticleTexture()==sprite,"exact cable particle");
    close(model.getItemCameraTransforms().gui.scale.x,.625F,"native GUI transform");check(model.getOverrides().getOverrides().isEmpty(),"no invented overrides");
    for(int mask=0;mask<64;mask++){
     String label=(old?"classic":"modern")+":"+(item?"inventory":"world")+":"+mask;
     IBlockState state=((IExtendedBlockState)(old?classic:modern).getDefaultState()).withProperty(ConnectionState.CONNECTIONS,mask);
     List<BakedQuad> q=old?RenderCableClassic.bake(mask,item,sprite):RenderCable.bake(mesh,mask,item,sprite);
     List<OriginalCableOracle.Vertex[]> expected=old?(item?OriginalCableOracle.classicItem(sprite):OriginalCableOracle.classicWorld(sprite,mask)):modernOracle(oracle,mask,item,sprite);
     if(old)check(expected.size()==(item?22:6+3*Integer.bitCount(mask)),label+" source cap/arm count");
     geometry(q,expected,item,sprite,label+" direct");geometry(model.getQuads(state,null,17),expected,item,sprite,label+" model");
     check(model.getQuads(state,null,0)==model.getQuads(state,null,99),label+" immutable cached variant independent of RNG");
     for(EnumFacing face:EnumFacing.values())check(model.getQuads(state,face,0).isEmpty(),label+" no duplicated culled bucket "+face);
     if(!item)lighting(model,state,label);
    }
   }
   ResourceLocation png=new ResourceLocation("hbm","textures/blocks/"+(old?"red_cable_classic":"cable_neo")+".png");check(pack.resourceExists(png),"exact-case cable texture present");try(InputStream in=pack.getInputStream(png)){check(ImageIO.read(in)!=null,"actual cable PNG decodes");}
  }
 }
 static final class ConnectorBlock extends Block implements IEnergyConnectorBlock {
  ForgeDirection expected;boolean allow;int calls;BlockPos last;ConnectorBlock(){super(Material.IRON);}
  public boolean canConnect(IBlockAccess world,int x,int y,int z,ForgeDirection side){calls++;last=new BlockPos(x,y,z);check(side==expected,"connector block receives opposite machine-facing side");return allow;}
 }
 static final class ConnectorTile extends TileEntity implements IEnergyConnectorMK2 {
  ForgeDirection expected;boolean allow;int calls;public boolean canConnect(ForgeDirection side){calls++;check(side==expected,"connector tile receives opposite machine-facing side");return allow;}
 }
 static final class ConnectionsWorld implements IBlockAccess {
  final Map<BlockPos,IBlockState> blocks=new HashMap<>();final Map<BlockPos,TileEntity> tiles=new HashMap<>();int reads;
  public TileEntity getTileEntity(BlockPos p){reads++;check(p.getY()>=0&&p.getY()<256,"height guard before tile access");return tiles.get(p);}
  public IBlockState getBlockState(BlockPos p){reads++;check(p.getY()>=0&&p.getY()<256,"height guard before block access");return blocks.getOrDefault(p,Blocks.AIR.getDefaultState());}
  public int getCombinedLight(BlockPos p,int e){return 0;}public boolean isAirBlock(BlockPos p){return getBlockState(p).getBlock()==Blocks.AIR;}public net.minecraft.world.biome.Biome getBiome(BlockPos p){return Biomes.PLAINS;}
  public int getStrongPower(BlockPos p,EnumFacing f){return 0;}public WorldType getWorldType(){return WorldType.DEFAULT;}public boolean isSideSolid(BlockPos p,EnumFacing f,boolean fallback){return false;}
 }
 static AxisAlignedBB bounds(int mask){return new AxisAlignedBB((mask&16)!=0?0:.34375,(mask&4)!=0?0:.34375,(mask&1)!=0?0:.34375,(mask&32)!=0?1:.65625,(mask&8)!=0?1:.65625,(mask&2)!=0?1:.65625);}
 static void stateAndConnections(){
  EnumFacing[] dirs={EnumFacing.EAST,EnumFacing.WEST,EnumFacing.UP,EnumFacing.DOWN,EnumFacing.SOUTH,EnumFacing.NORTH};int[] bits={32,16,8,4,2,1};
  for(BlockCable cable:new BlockCable[]{modern,classic}){
   check(cable.getBlockState().getValidStates().size()==16,"connections are unlisted, never persisted as extra metadata");
   for(int meta=0;meta<16;meta++){
    IBlockState base=cable.getStateFromMeta(meta);check(cable.getMetaFromState(base)==meta,"all sixteen metadata preserved");check(base.getRenderType()==EnumBlockRenderType.MODEL&&!base.isOpaqueCube()&&!base.isFullCube(),"native model non-full nonopaque cable");
    check(base.getMaterial()==Material.IRON,"original iron material");check(cable.createNewTileEntity(null,meta) instanceof com.hbm.tileentity.network.TileEntityCableBaseNT,"original cable tile identity");
    check(!cable.canPlaceTorchOnTop(base,null,POS),"no invented torch support");
    for(EnumFacing face:EnumFacing.values()){check(cable.getBlockFaceShape(null,base,POS,face)==BlockFaceShape.UNDEFINED,"no solid face support");check(!cable.isSideSolid(base,null,POS,face),"legacy nonnormal cable side nonsolid");}
    for(int mask=0;mask<64;mask++)for(int mode=0;mode<3;mode++){
     ConnectionsWorld world=new ConnectionsWorld();world.blocks.put(POS,base);
     for(int i=0;i<6;i++){
      BlockPos target=POS.offset(dirs[i]);ForgeDirection opposite=ForgeDirection.fromEnumFacing(dirs[i].getOpposite());boolean allow=(mask&bits[i])!=0;
      if(mode!=1){ConnectorBlock b=new ConnectorBlock();b.expected=opposite;b.allow=mode==0&&allow;world.blocks.put(target,b.getDefaultState());}
      if(mode!=0){ConnectorTile tile=new ConnectorTile();tile.expected=opposite;tile.allow=allow;world.tiles.put(target,tile);}
     }
     IBlockState extended=cable.getExtendedState(base,world,POS);check(extended instanceof IExtendedBlockState,"native extended connection state");check(((IExtendedBlockState)extended).getValue(ConnectionState.CONNECTIONS)==mask,"all64 neighbor connection masks "+mode);
     check(cable.getMetaFromState(extended)==meta,"render connections never mutate metadata");check(((IExtendedBlockState)extended).getClean()==base,"extended state cleans to exact persisted state");
     check(cable.getBoundingBox(base,world,POS).equals(bounds(mask)),"original merged selection bounds "+mask);check(cable.getCollisionBoundingBox(base,world,POS).equals(bounds(mask)),"original merged collision bounds "+mask);
     check(BlockCable.bounds(mask).equals(bounds(mask)),"bounds helper exact mask mapping");
    }
   }
  }
  for(int y:new int[]{-1,256,Integer.MIN_VALUE,Integer.MAX_VALUE}){ConnectionsWorld world=new ConnectionsWorld();check(!Library.canConnect(world,0,y,0,ForgeDirection.UP)&&world.reads==0,"original y-boundary short circuit");}
  for(EnumFacing direction:dirs){ConnectionsWorld world=new ConnectionsWorld();BlockPos p=POS.offset(direction);ConnectorBlock block=new ConnectorBlock();block.expected=ForgeDirection.fromEnumFacing(direction.getOpposite());block.allow=true;world.blocks.put(p,block.getDefaultState());ConnectorTile tile=new ConnectorTile();tile.expected=block.expected;tile.allow=true;world.tiles.put(p,tile);check(Library.canConnect(world,p.getX(),p.getY(),p.getZ(),ForgeDirection.fromEnumFacing(direction)),"block connector accepts");check(block.calls==1&&tile.calls==0&&block.last.equals(p),"original accepting block short-circuits tile fallback");}
  check(ConnectionState.CONNECTIONS.isValid(0)&&ConnectionState.CONNECTIONS.isValid(63)&&!ConnectionState.CONNECTIONS.isValid(-1)&&!ConnectionState.CONNECTIONS.isValid(64)&&!ConnectionState.CONNECTIONS.isValid(null),"render-only mask property validation");
 }
 static final class NativeWorld extends World {
  final Map<Long,Chunk> chunks=new HashMap<>();NativeWorld(){super(new SaveHandlerMP(),new WorldInfo(new NBTTagCompound()),new WorldProviderSurface(),new Profiler(),false);provider.setWorld(this);chunkProvider=createChunkProvider();for(int x=-1;x<=1;x++)for(int z=-1;z<=1;z++){Chunk c=new Chunk(this,x,z);c.markLoaded(true);chunks.put(key(x,z),c);}}
  static long key(int x,int z){return ((long)x<<32)^(z&0xffffffffL);}
  protected IChunkProvider createChunkProvider(){return new IChunkProvider(){public Chunk getLoadedChunk(int x,int z){return chunks.get(key(x,z));}public Chunk provideChunk(int x,int z){return getLoadedChunk(x,z);}public boolean tick(){return false;}public String makeString(){return "native cable fixture";}public boolean isChunkGeneratedAt(int x,int z){return getLoadedChunk(x,z)!=null;}};}
  protected boolean isChunkLoaded(int x,int z,boolean allowEmpty){return chunks.containsKey(key(x,z));}
  public boolean checkLight(BlockPos p){return true;}
 }
 static void nativeWorld(){
  for(BlockCable cable:new BlockCable[]{modern,classic})for(int meta=0;meta<16;meta++){
   NativeWorld world=new NativeWorld();world.setBlockState(POS,cable.getStateFromMeta(meta),3);TileEntity tile=world.getTileEntity(POS);check(tile instanceof com.hbm.tileentity.network.TileEntityCableBaseNT&&tile.getPos().equals(POS),"real Chunk creates native cable tile");
   for(EnumFacing face:EnumFacing.values())world.setBlockState(POS.offset(face),cable.getDefaultState(),3);
   IBlockState actual=world.getBlockState(POS);IExtendedBlockState render=(IExtendedBlockState)cable.getExtendedState(actual,world,POS);check(cable.getMetaFromState(actual)==meta&&render.getValue(ConnectionState.CONNECTIONS)==63,"real World neighbor tiles resolve all64 mask and metadata");
   world.setBlockState(POS.east(),Blocks.AIR.getDefaultState(),3);render=(IExtendedBlockState)cable.getExtendedState(world.getBlockState(POS),world,POS);check(render.getValue(ConnectionState.CONNECTIONS)==31,"real neighbor removal updates next render without stored stale mask");check(world.getTileEntity(POS)==tile,"neighbor update retains cable tile");
   List<AxisAlignedBB> boxes=new ArrayList<>();AxisAlignedBB large=new AxisAlignedBB(POS).grow(2);cable.addCollisionBoxToList(actual,world,POS,large,boxes,null,false);check(boxes.size()==1&&boxes.get(0).equals(bounds(31).offset(POS)),"native world collision hook offsets original one merged box");
  }
 }
 static sun.misc.Unsafe unsafe;static SimpleReloadableResourceManager sharedResources;
 static void set(Object o,Class<?> c,String field,Object value)throws Exception{Field f=c.getDeclaredField(field);f.setAccessible(true);f.set(o,value);}
 static Object get(Object o,Class<?> c,String field)throws Exception{Field f=c.getDeclaredField(field);f.setAccessible(true);return f.get(o);}
 static void event()throws Exception{
  Class<?> type=com.hbm.main.ConnectionBlockModelHandler.class;net.minecraftforge.fml.common.Mod.EventBusSubscriber ann=type.getAnnotation(net.minecraftforge.fml.common.Mod.EventBusSubscriber.class);
  check(ann!=null&&ann.modid().equals("hbm")&&Arrays.equals(ann.value(),new net.minecraftforge.fml.relauncher.Side[]{net.minecraftforge.fml.relauncher.Side.CLIENT}),"native automatic client-only subscriber");int count=0;
  for(Method m:type.getDeclaredMethods())if(m.isAnnotationPresent(net.minecraftforge.fml.common.eventhandler.SubscribeEvent.class)&&Arrays.equals(m.getParameterTypes(),new Class<?>[]{net.minecraftforge.client.event.ModelRegistryEvent.class})){check(Modifier.isStatic(m.getModifiers()),"native subscribed handler static");m.invoke(null,new net.minecraftforge.client.event.ModelRegistryEvent());count++;}
  check(count==1,"one native model-registry subscriber");
 }
 static IBakedModel bake(ResourceLocation id,boolean item,TextureAtlasSprite sprite)throws Exception{
  net.minecraftforge.client.model.IModel model=net.minecraftforge.client.model.ModelLoaderRegistry.getModel(id);check(model!=net.minecraftforge.client.model.ModelLoaderRegistry.getMissingModel(),"actual custom loader, never missing placeholder: "+id);
  check(model.getDependencies().isEmpty(),"no fabricated model dependencies");check(new HashSet<ResourceLocation>(model.getTextures()).equals(Collections.singleton(new ResourceLocation(sprite.getIconName()))),"exact advertised cable atlas dependency");
  return model.bake(model.getDefaultState(),item?DefaultVertexFormats.ITEM:DefaultVertexFormats.BLOCK,r->{check(r.toString().equals(sprite.getIconName()),"real bake requested original texture");return sprite;});
 }
 static final class ChangedObjPack implements IResourcePack {
  final IResourcePack original;ChangedObjPack(IResourcePack p){original=p;}
  public InputStream getInputStream(ResourceLocation id)throws IOException{
   if(!id.equals(new ResourceLocation("hbm","models/blocks/cable_neo.obj")))return original.getInputStream(id);
   ByteArrayOutputStream b=new ByteArrayOutputStream();try(InputStream in=original.getInputStream(id)){byte[] data=new byte[4096];int n;while((n=in.read(data))!=-1)b.write(data,0,n);}
   String[] lines=new String(b.toByteArray(),StandardCharsets.UTF_8).split("\\n");StringBuilder changed=new StringBuilder();
   for(String line:lines){if(line.startsWith("v ")){String[] p=line.trim().split("\\s+");line="v "+(Float.parseFloat(p[1])+.0625F)+" "+p[2]+" "+p[3];}changed.append(line).append('\n');}
   return new ByteArrayInputStream(changed.toString().getBytes(StandardCharsets.UTF_8));
  }
  public boolean resourceExists(ResourceLocation id){return original.resourceExists(id);}public Set<String> getResourceDomains(){return original.getResourceDomains();}
  public <T extends net.minecraft.client.resources.data.IMetadataSection>T getPackMetadata(net.minecraft.client.resources.data.MetadataSerializer m,String k)throws IOException{return original.getPackMetadata(m,k);}
  public java.awt.image.BufferedImage getPackImage()throws IOException{return original.getPackImage();}public String getPackName(){return "Controlled translated original cable OBJ";}
 }
 static void registry(IResourcePack pack,Map<String,List<Face>> oracle)throws Exception{
  if(sharedResources==null){Field f=sun.misc.Unsafe.class.getDeclaredField("theUnsafe");f.setAccessible(true);unsafe=(sun.misc.Unsafe)f.get(null);sharedResources=new SimpleReloadableResourceManager(new net.minecraft.client.resources.data.MetadataSerializer());net.minecraft.client.Minecraft minecraft=(net.minecraft.client.Minecraft)unsafe.allocateInstance(net.minecraft.client.Minecraft.class);set(null,net.minecraft.client.Minecraft.class,"instance",minecraft);set(minecraft,net.minecraft.client.Minecraft.class,"resourceManager",sharedResources);}
  sharedResources.reloadResources(Collections.singletonList(pack));net.minecraft.launchwrapper.Launch.blackboard=new HashMap<String,Object>();net.minecraft.launchwrapper.Launch.blackboard.put("fml.deobfuscatedEnvironment",Boolean.TRUE);
  TextureMap atlas=new TextureMap("textures");ModelManager loaderManager=new ModelManager(atlas);net.minecraft.client.renderer.BlockModelShapes shapes=new net.minecraft.client.renderer.BlockModelShapes(loaderManager);
  new net.minecraftforge.client.model.ModelLoader(sharedResources,atlas,shapes);event();sharedResources.reloadResources(Collections.singletonList(pack));net.minecraftforge.client.model.ModelLoaderRegistry.clearModelCache(sharedResources);
  Map<?,?> custom=(Map<?,?>)get(null,net.minecraftforge.client.model.ModelLoader.class,"customModels");check(custom.size()==32,"two cable ItemBlocks each sixteen metadata registrations");
  net.minecraftforge.client.model.ModelLoader.onRegisterAllBlocks(shapes);net.minecraft.util.registry.RegistrySimple<ModelResourceLocation,IBakedModel> baked=new net.minecraft.util.registry.RegistrySimple<>();
  for(BlockCable block:new BlockCable[]{modern,classic}){
   boolean old=block==classic;TextureAtlasSprite sprite=new Sprite("hbm:blocks/"+(old?"red_cable_classic":"cable_neo"),old?3:1);
   Map<IBlockState,ModelResourceLocation> mapping=shapes.getBlockStateMapper().getVariants(block);check(mapping.size()==16,"native mapper covers sixteen persisted metadata states");check(new HashSet<ModelResourceLocation>(mapping.values()).size()==1,"native registered mapper truly ignores metadata");
   ResourceLocation path=new ResourceLocation("hbm","blockstates/"+block.getRegistryName().getPath()+".json");ModelBlockDefinition definition;
   try(Reader r=new InputStreamReader(pack.getInputStream(path),StandardCharsets.UTF_8)){definition=ModelBlockDefinition.parseFromReader(r,block.getRegistryName());}
   ModelResourceLocation mapped=mapping.values().iterator().next();check(definition.hasVariant(mapped.getVariant()),"exact mapped blockstate variant exists");List<Variant> variants=definition.getVariant(mapped.getVariant()).getVariantList();check(variants.size()==1,"one deterministic custom native world model");Variant variant=variants.get(0);
   check(variant.getRotation()==ModelRotation.X0_Y0&&!variant.isUvLock(),"no unintended model/UV rotation");IBakedModel model=bake(variant.getModelLocation(),false,sprite);baked.putObject(mapped,model);
   for(int mask=0;mask<64;mask++){IBlockState extended=((IExtendedBlockState)block.getDefaultState()).withProperty(ConnectionState.CONNECTIONS,mask);geometry(model.getQuads(extended,null,0),old?OriginalCableOracle.classicWorld(sprite,mask):modernOracle(oracle,mask,false,sprite),false,sprite,"native loader world mask"+mask);}
   for(String prefix:new String[]{"","block/"}){
    IBakedModel route=bake(new ResourceLocation("hbm",prefix+"native_connections/"+(old?"classic":"cable")+"/world"),false,sprite);
    geometry(route.getQuads(null,null,0),old?OriginalCableOracle.classicWorld(sprite,0):modernOracle(oracle,0,false,sprite),false,sprite,"loader normalized prefix "+prefix);
   }
   for(int meta=0;meta<16;meta++){Item item=Item.getItemFromBlock(block);ModelResourceLocation id=(ModelResourceLocation)custom.get(org.apache.commons.lang3.tuple.Pair.of(item.delegate,meta));check(id!=null,"real item model registration all metadata");IBakedModel itemModel=bake(id,true,sprite);baked.putObject(id,itemModel);geometry(itemModel.getQuads(null,null,0),old?OriginalCableOracle.classicItem(sprite):modernOracle(oracle,0,true,sprite),true,sprite,"loader inventory metadata"+meta);}
  }
  ModelManager manager=(ModelManager)unsafe.allocateInstance(ModelManager.class);set(manager,ModelManager.class,"modelRegistry",baked);net.minecraft.client.renderer.ItemModelMesher mesher=new net.minecraft.client.renderer.ItemModelMesher(manager);net.minecraftforge.client.model.ModelLoader.onRegisterItems(mesher);mesher.rebuildCache();
  for(BlockCable block:new BlockCable[]{modern,classic})for(int meta=0;meta<16;meta++){Item item=Item.getItemFromBlock(block);ModelResourceLocation id=(ModelResourceLocation)custom.get(org.apache.commons.lang3.tuple.Pair.of(item.delegate,meta));check(mesher.getItemModel(new ItemStack(item,1,meta))==baked.getObject(id),"actual native ItemModelMesher allmetadata route");}
  TextureAtlasSprite sprite=new Sprite("hbm:blocks/cable_neo",1);ResourceLocation id=new ResourceLocation("hbm","native_connections/cable/world");net.minecraftforge.client.model.IModel old=net.minecraftforge.client.model.ModelLoaderRegistry.getModel(id);float before=Float.intBitsToFloat(bake(id,false,sprite).getQuads(null,null,0).get(0).getVertexData()[0]);
  sharedResources.reloadResources(Collections.singletonList(new ChangedObjPack(pack)));net.minecraftforge.client.model.ModelLoaderRegistry.clearModelCache(sharedResources);
  check(net.minecraftforge.client.model.ModelLoaderRegistry.getModel(id)!=old,"real resource reload invalidates unbaked cache");close(Float.intBitsToFloat(bake(id,false,sprite).getQuads(null,null,0).get(0).getVertexData()[0]),before+.0625F,"reload reparses changed original OBJ instead of stale mesh");
  sharedResources.reloadResources(Collections.singletonList(pack));net.minecraftforge.client.model.ModelLoaderRegistry.clearModelCache(sharedResources);close(Float.intBitsToFloat(bake(id,false,sprite).getQuads(null,null,0).get(0).getVertexData()[0]),before,"reload restores original OBJ");
 }

 public static void main(String[] args)throws Exception{
  Bootstrap.register();setup();stateAndConnections();nativeWorld();Map<String,List<Face>> oracle;try(Reader r=new InputStreamReader(new FileInputStream(args[2]),StandardCharsets.UTF_8)){oracle=originalObj(r);}
  try(FileResourcePack zip=new FileResourcePack(new File(args[1]))){IResourcePack folder=new FolderResourcePack(new File(args[0]));direct(folder,oracle);direct(zip,oracle);registry(folder,oracle);registry(zip,oracle);}
  System.out.println("PASS native cable parity: "+checks+" assertions; complete production cable/model classes, all64 modern and classic masks, independent pinned-source/original-OBJ vertices UV normals shades, original separate inventory variants, real Forge and vanilla light pipelines, allmetadata bounds and connection fallback, real World/Chunk tile lifecycle, native event/statemapper/ItemModelMesher routing and changed-OBJ resource reload; directory and packaged resources.");
  System.out.println("Boundaries: controlled NTM registry and cable tile collaborators; unchanged production Library.canConnect method extracted for isolation; real Minecraft/Forge classes throughout. CPU-headless fixture, not live graphical acceptance.");
 }
