import java.util.*;import java.lang.reflect.*;
import net.minecraft.block.state.IBlockState;import net.minecraft.init.*;import net.minecraft.util.*;import net.minecraft.util.math.BlockPos;import net.minecraft.world.*;import net.minecraft.world.chunk.*;import net.minecraft.world.storage.*;import net.minecraft.nbt.*;import net.minecraft.profiler.Profiler;import net.minecraft.tileentity.TileEntity;
import com.hbm.util.fauxpointtwelve.DirPos;import com.hbm.lib.ForgeDirection;
public class PowerNativeTest {
 static int checks,expressions;static NativeWorld server,client;static final EnumFacing[] POWER={EnumFacing.DOWN,EnumFacing.UP,EnumFacing.NORTH,EnumFacing.SOUTH,EnumFacing.WEST,EnumFacing.EAST};static final RuntimeException BOOM=new IllegalStateException("power boundary failure");
 static void check(boolean v,String text){checks++;if(!v)throw new AssertionError(text);}
 public static void main(String[] args)throws Exception {Bootstrap.register();server=new NativeWorld(false);client=new NativeWorld(true);ExpressionCases e=new ExpressionCases();RUN_EXPRESSIONS
 modes();ports();door();tick();lambda();blastDoor();evaluationOrder(e);integerCoordinates(e);System.out.println("PASS "+checks+" actual-native assertions: "+expressions+" exact selected expressions, seven complete selected methods and one complete lambda; five complete production coordinate collaborators. World/Chunk/redstone paths are native; domain effect sinks and owner shells are bounded fixtures, not full machine gameplay.");}
 static void clear(NativeWorld w,BlockPos p){for(EnumFacing f:EnumFacing.values())w.setBlockState(p.offset(f),Blocks.AIR.getDefaultState(),2);w.setBlockState(p,Blocks.AIR.getDefaultState(),2);}
 static void reset(){server.queries.clear();server.powerReads.clear();client.queries.clear();client.powerReads.clear();}
 static void supply(NativeWorld w,BlockPos p,int face){clear(w,p);if(face>=0)w.setBlockState(p.offset(POWER[face]),Blocks.REDSTONE_BLOCK.getDefaultState(),2);reset();}
 static Method expressionMethod(int i)throws Exception{return ExpressionCases.class.getMethod("case"+i,World.class,int.class,int.class,int.class,DirPos.class);}
 static boolean invoke(ExpressionCases e,int i,World world,int x,int y,int z,DirPos pos)throws Exception {try{return (Boolean)expressionMethod(i).invoke(e,world,x,y,z,pos);}catch(InvocationTargetException ex){Throwable cause=ex.getCause();if(cause instanceof RuntimeException)throw (RuntimeException)cause;if(cause instanceof Error)throw (Error)cause;throw ex;}}
 static void expression(ExpressionCases e,int i,String kind,int delta,boolean inherited)throws Exception {expressions++;for(NativeWorld active:new NativeWorld[]{server,client})for(int face=-1;face<6;face++){NativeWorld other=active==server?client:server;e.setWorld(inherited?active:other);e.rawPos(new BlockPos(-3,70,-5));DirPos local=new DirPos(-6,72,-8,ForgeDirection.UP);BlockPos target=kind.equals("tile")?new BlockPos(-3,70+delta,-5):kind.equals("offset")?new BlockPos(-1,70,-1):kind.equals("local")?new BlockPos(-6,72,-8):new BlockPos(2,71+delta,4);supply(active,target,face);boolean actual=invoke(e,i,inherited?other:active,2,71,4,local);check(actual==(face>=0),"native expression "+i+" boolean result");check(active.queries.equals(Arrays.asList(target))&&other.queries.isEmpty(),"expression "+i+" exact receiver/position/once");List<String> expected=new ArrayList<>();for(int j=0;j<(face<0?6:face+1);j++)expected.add(target.offset(POWER[j])+"/"+POWER[j]);check(active.powerReads.equals(expected),"native real six-face order and short circuit "+i);}}
 static <T extends TileEntity>T tile(T t,World w,BlockPos p){t.setWorld(w);t.setPos(p);return t;}
 static void modes(){BlockPos p=new BlockPos(-4,80,-4);SingleMode s=tile(new SingleMode(),server,p);MultiMode m=tile(new MultiMode(),server,p);m.ports=new com.hbm.util.fauxpointtwelve.BlockPos[]{new com.hbm.util.fauxpointtwelve.BlockPos(-4,80,-4),new com.hbm.util.fauxpointtwelve.BlockPos(5,80,5)};for(boolean powered:new boolean[]{false,true}){supply(server,p,powered?0:-1);clear(server,new BlockPos(5,80,5));reset();check(s.getRelevantMode(false)==(powered?3:1),"single mode original high/low");check(server.queries.equals(Arrays.asList(p)),"single mode one query");reset();check(s.getRelevantMode(true)==(powered?3:1)&&server.queries.isEmpty(),"single cache bypass");check(m.getRelevantMode(false)==(powered?3:1),"multi mode original high/low");check(server.queries.equals(powered?Arrays.asList(p):Arrays.asList(p,new BlockPos(5,80,5))),"multi mode port order/early break");int calls=m.portsCalls;reset();check(m.getRelevantMode(true)==(powered?3:1)&&server.queries.isEmpty()&&m.portsCalls==calls,"multi cache bypass includes port supplier");}}
 static void ports(){BlockPos a=new BlockPos(-4,90,-4),b=new BlockPos(5,90,5);Dipole d=tile(new Dipole(),server,new BlockPos(9,90,9));d.ports=new DirPos[]{new DirPos(-4,90,-4,ForgeDirection.UP),new DirPos(5,90,5,ForgeDirection.EAST)};for(int which=-1;which<2;which++){clear(server,a);clear(server,b);if(which>=0)server.setBlockState((which==0?a:b).down(),Blocks.REDSTONE_BLOCK.getDefaultState(),2);reset();check(d.checkRedstone()==(which>=0),"dipole original multiport predicate");check(server.queries.equals(which==0?Arrays.asList(a):Arrays.asList(a,b)),"dipole local pos shadows native tile pos; order/early return");}MiningLaser l=tile(new MiningLaser(),server,new BlockPos(9,90,9));l.ports=new DirPos[]{new DirPos(-4,91,-4,ForgeDirection.UP),new DirPos(6,90,5,ForgeDirection.EAST)};clear(server,a);supply(server,b,0);check(l.invoke(),"laser opposite-direction coordinate query");check(server.queries.equals(Arrays.asList(a,b)),"laser uses computed local custom pos not tile pos");}
 static void door(){BlockPos p=new BlockPos(-5,100,-5);DoorPower d=tile(new DoorPower(),server,p);d.redstonePower=-1;supply(server,p,0);d.updateRedstonePower(-5,100,-5);check(d.redstonePower==1&&d.activatedBlocks.size()==1,"door rising edge count");d.updateRedstonePower(-5,100,-5);check(d.redstonePower==1&&d.activatedBlocks.size()==1,"door held power not double count");supply(server,p,-1);d.updateRedstonePower(-5,100,-5);check(d.redstonePower==-1&&d.activatedBlocks.isEmpty(),"door falling edge sentinel");d.updateRedstonePower(-5,100,-5);check(d.redstonePower==-1&&d.activatedBlocks.isEmpty(),"door held unpowered unchanged");}
 static void tick(){BlockPos p=new BlockPos(-5,110,-5);for(NativeWorld w:new NativeWorld[]{server,client})for(boolean powered:new boolean[]{false,true}){Chlorine c=tile(new Chlorine(),w,p);supply(w,p,powered?0:-1);((ITickable)c).update();check(c.spreads==(!w.isRemote&&powered?1:0),"actual native ITickable callback unchanged server/power gate");check(w.queries.size()==(w.isRemote?0:1),"tick remote suppresses entire power query");if(c.spreads!=0)check(Arrays.equals(c.xyz,new int[]{-5,110,-5}),"spread exact coordinates");}}
 static void lambda(){BlockPos p=new BlockPos(3,120,5);LogicBlock.TileEntityLogicBlock t=tile(new LogicBlock.TileEntityLogicBlock(),server,p);for(boolean powered:new boolean[]{false,true}){supply(server,p,powered?0:-1);check(LogicCondition.REDSTONE.apply(t)==powered,"complete local-World lambda return");check(server.queries.equals(Arrays.asList(p)),"lambda typed local exact world and coords");}}
 static void blastDoor(){BlockPos p=new BlockPos(-6,130,-6),top=p.up(6);for(boolean locked:new boolean[]{false,true})for(boolean base:new boolean[]{false,true})for(boolean upper:new boolean[]{false,true}){BlastDoor d=tile(new BlastDoor(),server,p);d.locked=locked;clear(server,p);clear(server,top);if(base)server.setBlockState(p.down(),Blocks.REDSTONE_BLOCK.getDefaultState(),2);if(upper)server.setBlockState(top.down(),Blocks.REDSTONE_BLOCK.getDefaultState(),2);reset();int packets=PacketDispatcher.packets;((ITickable)d).update();boolean expected=(!locked&&base)||upper;check(d.redstoned==expected&&d.toggles==(expected?1:0),"original blast-door precedence including locked upper power");List<BlockPos> queries=new ArrayList<>();if(!locked)queries.add(p);if(locked||!base)queries.add(top);check(server.queries.equals(queries)&&d.locks==1,"blast-door original query order/short circuit");check(PacketDispatcher.packets==packets+1,"original packet path after query retained");reset();d.update();check(d.toggles==(expected?1:0),"held blast-door power does not toggle twice");}BlastDoor c=tile(new BlastDoor(),client,p);reset();c.update();check(c.locks==0&&client.queries.isEmpty(),"blast-door remote early gate");}
 static class CountingDir extends DirPos {final List<String> events=new ArrayList<>();boolean fail;CountingDir(){super(-3,70,-5,ForgeDirection.UP);}@Override public int getX(){events.add("x");mutate(-3,73,7);return -3;}@Override public int getY(){events.add("y");if(fail)throw BOOM;return super.getY();}@Override public int getZ(){events.add("z");return super.getZ();}}
 static void evaluationOrder(ExpressionCases e)throws Exception {
  int local=LOCAL_CASE,tile=TILE_CASE;CountingDir d=new CountingDir();e.setWorld(server);supply(server,new BlockPos(-3,73,7),0);check(invoke(e,local,client,0,0,0,d),"original custom mutable position getters preserved");check(d.events.equals(Arrays.asList("x","y","z"))&&server.queries.equals(Arrays.asList(new BlockPos(-3,73,7))),"local getter evaluation exactly once/left to right");
  d=new CountingDir();d.fail=true;reset();try{invoke(e,local,client,0,0,0,d);throw new AssertionError("missing getter failure");}catch(RuntimeException ex){check(ex==BOOM&&d.events.equals(Arrays.asList("x","y"))&&server.queries.isEmpty(),"getter exception before z/native query");}
  d=new CountingDir();e.setWorld(null);reset();try{invoke(e,local,client,0,0,0,d);throw new AssertionError("missing null receiver");}catch(NullPointerException ex){check(d.events.equals(Arrays.asList("x","y","z")),"null receiver check remains after argument evaluation");}
  e.setWorld(server);e.rawPos(new BlockPos(-3,70,-5){@Override public int getX(){e.setWorld(client);e.rawPos(new BlockPos(8,73,7));return -3;}});supply(server,new BlockPos(-3,73,7),0);check(invoke(e,tile,client,0,0,0,new DirPos(0,0,0,ForgeDirection.UP)),"receiver cached before argument side effect");check(server.queries.equals(Arrays.asList(new BlockPos(-3,73,7)))&&client.queries.isEmpty(),"this.pos field is reread for y/z; World receiver evaluated once before coords");
  e.setWorld(server);d=new CountingDir();server.throwQuery=true;reset();try{invoke(e,local,client,0,0,0,d);throw new AssertionError("missing world failure");}catch(RuntimeException ex){check(ex==BOOM&&d.events.equals(Arrays.asList("x","y","z"))&&server.queries.size()==1,"same World exception after all coordinate effects; no retry");}finally{server.throwQuery=false;}
 }
 static void integerCoordinates(ExpressionCases e)throws Exception {
  e.setWorld(server);e.rawPos(new BlockPos(Integer.MIN_VALUE,Integer.MAX_VALUE,Integer.MAX_VALUE));server.throwQuery=true;
  int[] cases={SCALAR_CASE,PLUS_ONE_CASE,PLUS_SIX_CASE,OFFSET_CASE};
  BlockPos[] expected={new BlockPos(Integer.MIN_VALUE,Integer.MAX_VALUE,-1),new BlockPos(Integer.MIN_VALUE,Integer.MIN_VALUE,-1),new BlockPos(Integer.MIN_VALUE,Integer.MIN_VALUE+5,Integer.MAX_VALUE),new BlockPos(0,Integer.MAX_VALUE,Integer.MAX_VALUE-1)};
  try{for(int i=0;i<cases.length;i++){reset();try{invoke(e,cases[i],server,Integer.MIN_VALUE,Integer.MAX_VALUE,-1,new DirPos(0,0,0,ForgeDirection.UP));throw new AssertionError("missing bounded coordinate capture");}catch(RuntimeException ex){check(ex==BOOM&&server.queries.equals(Arrays.asList(expected[i]))&&server.powerReads.isEmpty(),"exact signed-int coordinate construction/overflow before native leaf query");}}}finally{server.throwQuery=false;}
 }
 static final class NativeWorld extends World {
  final Map<Long,Chunk> chunks=new HashMap<>();final List<BlockPos> queries=new ArrayList<>();final List<String> powerReads=new ArrayList<>();boolean throwQuery;
  NativeWorld(boolean remote){super(new SaveHandlerMP(),new WorldInfo(new NBTTagCompound()),new WorldProviderSurface(),new Profiler(),remote);provider.setWorld(this);chunkProvider=createChunkProvider();for(int x=-1;x<=1;x++)for(int z=-1;z<=1;z++){Chunk c=new Chunk(this,x,z);c.markLoaded(true);chunks.put(key(x,z),c);}}
  static long key(int x,int z){return ((long)x<<32)^(z&0xffffffffL);}protected IChunkProvider createChunkProvider(){return new IChunkProvider(){public Chunk getLoadedChunk(int x,int z){return chunks.get(key(x,z));}public Chunk provideChunk(int x,int z){return getLoadedChunk(x,z);}public boolean tick(){return false;}public String makeString(){return "real preloaded chunks";}public boolean isChunkGeneratedAt(int x,int z){return getLoadedChunk(x,z)!=null;}};}protected boolean isChunkLoaded(int x,int z,boolean empty){return chunks.containsKey(key(x,z));}public boolean checkLight(BlockPos p){return true;}
  @Override public boolean isBlockPowered(BlockPos p){queries.add(p);if(throwQuery)throw BOOM;return super.isBlockPowered(p);}
  @Override public int getRedstonePower(BlockPos p,EnumFacing f){powerReads.add(p+"/"+f);return super.getRedstonePower(p,f);}
 }
}
