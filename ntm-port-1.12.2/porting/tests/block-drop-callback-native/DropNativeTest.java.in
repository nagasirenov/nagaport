import java.util.*;import java.io.*;import java.net.*;import java.lang.reflect.*;
import net.minecraft.block.Block;import net.minecraft.block.material.Material;import net.minecraft.block.state.IBlockState;import net.minecraft.init.Bootstrap;import net.minecraft.item.*;import net.minecraft.util.*;import net.minecraft.util.math.BlockPos;
import net.minecraft.world.*;import net.minecraft.world.chunk.*;import net.minecraft.world.storage.*;import net.minecraft.nbt.*;import net.minecraft.profiler.Profiler;import net.minecraft.entity.Entity;import net.minecraft.entity.item.EntityItem;
import net.minecraftforge.fml.common.*;import net.minecraftforge.fml.common.registry.ForgeRegistries;
public class DropNativeTest {
 static int checks,oldId=3000,nextName;static ClassLoader old;static Class<?> ob,oi,oldBlocks,oldItems;static Method oldDrop,oldQuantity,oldGetItem;static IdentityHashMap<Object,Item> counterparts=new IdentityHashMap<>();static NativeWorld world;static Object legacyTarget;static Block nativeTarget;static int predicates;
 static void check(boolean v,String text){checks++;if(!v)throw new AssertionError(text);}
 static Block register(Block b,String suffix){b.setRegistryName("hbm","drop_probe_"+suffix+"_"+(nextName++));ForgeRegistries.BLOCKS.register(b);ForgeRegistries.ITEMS.register(new ItemBlock(b).setRegistryName(b.getRegistryName()));return b;}
 static Object registerOld(Object b,Block counterpart)throws Exception{Object reg=ob.getField("c").get(null);reg.getClass().getMethod("a",int.class,String.class,Object.class).invoke(reg,oldId,"drop_probe_"+oldId,b);Object item=Class.forName("abh",true,old).getConstructor(ob).newInstance(b);Object ir=oi.getField("e").get(null);ir.getClass().getMethod("a",int.class,String.class,Object.class).invoke(ir,oldId,"drop_probe_"+oldId,item);oldId++;counterparts.put(item,Item.getItemFromBlock(counterpart));check(oldGetItem.invoke(null,b)==item,"actual original Block/Item registry binding");return b;}
 static Object legacy(String name)throws Exception{return Class.forName(name,true,old).newInstance();}
 public static void main(String[] args)throws Exception{
  Bootstrap.register();FMLCommonHandler.instance().beginLoading(net.minecraftforge.fml.server.FMLServerHandler.instance());ModMetadata md=new ModMetadata();md.modId="hbm";md.name="Native drop callback boundary";md.version="1";DummyModContainer c=new DummyModContainer(md);Loader.instance().setupTestHarness(c);Loader.instance().setActiveModContainer(c);
  old=new URLClassLoader(new URL[]{new File(args[1]).toURI().toURL()},new URLClassLoader(new URL[]{new File(args[0]).toURI().toURL()},DropNativeTest.class.getClassLoader()));ob=Class.forName("aji",true,old);oi=Class.forName("adb",true,old);ob.getMethod("p").invoke(null);oi.getMethod("l").invoke(null);oldBlocks=Class.forName("LegacyModBlocks",true,old);oldItems=Class.forName("LegacyModItems",true,old);oldDrop=ob.getMethod("a",int.class,Random.class,int.class);oldQuantity=ob.getMethod("a",int.class,Random.class);oldGetItem=oi.getMethod("a",ob);
  for(Field f:ModItems.class.getFields()){Item item=new Item().setRegistryName("hbm","drop_probe_"+f.getName());ForgeRegistries.ITEMS.register(item);f.set(null,item);Object original=oi.newInstance();oldItems.getField(f.getName()).set(null,original);counterparts.put(original,item);}
  Class<?> vi=Class.forName("LegacyItems",true,old),vb=Class.forName("LegacyBlocks",true,old);
  for(Field f:vi.getFields()){Item item=(Item)net.minecraft.init.Items.class.getField(f.getName()).get(null);Object original=oi.getMethod("d",int.class).invoke(null,Item.getIdFromItem(item));f.set(null,original);counterparts.put(original,item);}
  for(Field f:vb.getFields()){Block b=(Block)net.minecraft.init.Blocks.class.getField(f.getName()).get(null);Object original=ob.getMethod("b",String.class).invoke(null,Block.REGISTRY.getNameForObject(b).getPath());f.set(null,original);counterparts.put(oldGetItem.invoke(null,original),Item.getItemFromBlock(b));}
  for(Field f:ModBlocks.class.getFields()){Block b=register(new Block(Material.ROCK),f.getName());Object original=registerOld(legacy("LegacyTarget"),b);f.set(null,b);oldBlocks.getField(f.getName()).set(null,original);}
  nativeTarget=register(new Block(Material.ROCK),"field_target");legacyTarget=registerOld(legacy("LegacyTarget"),nativeTarget);world=new NativeWorld();
  RUN_CASES
  concreteOwners();derivedDispatch();vanillaParity();
  System.out.println("PASS "+checks+" original/native callback, identity, fortune, RNG, registry and lifecycle assertions; 83 complete method fixtures; "+predicates+" identity/field cases; seven complete production files including NoDrop and GenericDrop. Full mod and other owner lifecycle methods not compiled.");
 }
 static Object invoke(Method m,Object self,Object...args)throws Exception{try{return m.invoke(self,args);}catch(InvocationTargetException e){throw (Exception)e.getCause();}}
 static String outcome(Object o){return o==null?"null":String.valueOf(o);}
 static final class TracedRandom extends Random {final List<Integer> widths=new ArrayList<>();TracedRandom(long s){super(s);}@Override protected int next(int bits){widths.add(bits);return super.next(bits);}}
 static void runCase(int index,String owner,String[] ids)throws Exception{
  Block b=register((Block)Class.forName("NativeCase"+index).newInstance(),owner);Object original=registerOld(legacy("LegacyCase"+index),b);
  check(b.getClass().getMethod("getItemDropped",IBlockState.class,Random.class,int.class).getDeclaringClass()==b.getClass(),owner+" true native override");
  List<String> identities=new ArrayList<>();identities.add(null);identities.addAll(Arrays.asList(ids));
  for(String id:identities){Object oldSave=null,newSave=null;if(id!=null){newSave=ModBlocks.class.getField(id).get(null);oldSave=oldBlocks.getField(id).get(null);ModBlocks.class.getField(id).set(null,b);oldBlocks.getField(id).set(null,original);}
   for(boolean target:new boolean[]{false,true}){b.getClass().getField("single").set(b,target?nativeTarget:null);original.getClass().getField("single").set(original,target?legacyTarget:null);b.getClass().getField("drops").set(b,nativeTarget);original.getClass().getField("drops").set(original,legacyTarget);predicates++;
    for(int meta:new int[]{Integer.MIN_VALUE,-17,-1,0,1,2,3,6,7,8,15,16,31,Integer.MAX_VALUE})for(int fortune:new int[]{-2,-1,0,1,3,12})for(int seed=0;seed<32;seed++){
     TracedRandom nr=new TracedRandom(seed),lr=new TracedRandom(seed);Item actual=b.getItemDropped((meta&1)==0?b.getDefaultState():net.minecraft.init.Blocks.STONE.getStateFromMeta(meta&7),nr,fortune);Object expected=invoke(oldDrop,original,meta,lr,fortune);
     check(actual==counterparts.get(expected)&&(expected==null)==(actual==null),owner+" direct original/native item identity");check(nr.widths.equals(lr.widths)&&nr.nextLong()==lr.nextLong(),owner+" exact RNG sequence");
    }
    for(int fortune:new int[]{-2,0,1,3,10})for(int seed=0;seed<16;seed++)for(boolean allow:new boolean[]{false,true}){
     b.getClass().getField("allowFortune").setBoolean(b,allow);original.getClass().getField("allowFortune").setBoolean(original,allow);Random nr=new Random(seed),lr=new Random(seed);int nq=b.quantityDroppedWithBonus(fortune,nr);int oq=(Integer)invoke(oldQuantity,original,fortune,lr);check(nq==oq&&nr.nextLong()==lr.nextLong(),owner+" actual quantity/fortune/RNG dispatch");
     world.rand.setSeed(seed);lr=new Random(seed);int quantity=(Integer)invoke(oldQuantity,original,fortune,lr);List<Item> expected=new ArrayList<>();for(int n=0;n<quantity;n++){Object it=invoke(oldDrop,original,13,lr,fortune);if(it!=null)expected.add(counterparts.get(it));}
     NonNullList<ItemStack> drops=NonNullList.create();b.getDrops(drops,world,BlockPos.ORIGIN,b.getDefaultState(),fortune);List<Item> actual=new ArrayList<>();for(ItemStack stack:drops){if(stack.isEmpty()){check(expected.isEmpty(),owner+" original null becomes a native empty stack, not an item");continue;}actual.add(stack.getItem());check(stack.getCount()==1&&stack.getItemDamage()==0,owner+" fixture native stack boundary");}check(actual.equals(expected)&&world.rand.nextLong()==lr.nextLong(),owner+" real native Block.getDrops item/count/RNG boundary");
    }
   }
   if(id!=null){ModBlocks.class.getField(id).set(null,newSave);oldBlocks.getField(id).set(null,oldSave);}
  }
 }
 static void concreteOwners()throws Exception{
  Block none=register(new com.hbm.blocks.generic.BlockNoDrop(Material.ROCK),"complete_none");Block custom=register(new com.hbm.blocks.generic.BlockGenericDrop(Material.ROCK,nativeTarget),"complete_custom");BlockPos pos=new BlockPos(5,72,5);
  for(Block b:new Block[]{none,custom}){Random r=new Random(991),expected=new Random(991);check(b.getItemDropped(b.getDefaultState(),r,4)==(b==none?null:Item.getItemFromBlock(nativeTarget))&&r.nextLong()==expected.nextLong(),"complete production owner callback");world.setBlockState(pos,b.getDefaultState(),3);world.spawned.clear();check(world.destroyBlock(pos,true)&&world.isAirBlock(pos),"actual World.destroyBlock completes");check(world.spawned.size()==(b==none?0:1),"actual destruction respects native null/custom drop");if(b==custom)check(world.spawned.get(0).getItem()==Item.getItemFromBlock(nativeTarget),"actual EntityItem has custom drop");}
 }
 static class ChildNoDrop extends com.hbm.blocks.generic.BlockNoDrop {int calls;Random seen;int fortune;ChildNoDrop(){super(Material.ROCK);}@Override public Item getItemDropped(IBlockState s,Random r,int f){calls++;seen=r;fortune=f;return super.getItemDropped(s,r,f);}}
 static class ChildCustom extends com.hbm.blocks.generic.BlockGenericDrop {int calls;ChildCustom(){super(Material.ROCK,nativeTarget);}@Override public Item getItemDropped(IBlockState s,Random r,int f){calls++;return super.getItemDropped(s,r,f);}}
 static class FortuneChild extends NativeOutgasSlice {int calls;Random seen;int fortune;@Override public Item getItemDropped(IBlockState s,Random r,int f){calls++;seen=r;fortune=f;return net.minecraft.init.Items.DIAMOND;}}
 static void derivedDispatch(){ChildNoDrop n=new ChildNoDrop();Block b=n;Random r=new Random(4);check(b.getItemDropped(b.getDefaultState(),r,7)==null&&n.calls==1&&n.seen==r&&n.fortune==7,"actual production parent/derived/super dispatch once");ChildCustom c=new ChildCustom();b=c;check(b.getItemDropped(b.getDefaultState(),r,7)==Item.getItemFromBlock(nativeTarget)&&c.calls==1,"complete GenericDrop native derived override and super once");FortuneChild f=new FortuneChild();Random expected=new Random(7);r=new Random(7);int result=f.quantityDroppedWithBonus(3,r);int mult=Math.max(0,expected.nextInt(5)-1);check(result==mult+1&&f.calls==1&&f.seen==r&&f.fortune==3&&r.nextLong()==expected.nextLong(),"Outgas native internal fortune dispatch reaches derived override once");}
 static void vanillaParity()throws Exception{for(String name:new String[]{"stone","dirt","coal_ore","diamond_ore","emerald_ore","lapis_ore","quartz_ore"}){Object o=ob.getMethod("b",String.class).invoke(null,name);Block b=Block.getBlockFromName(name);for(int meta=0;meta<((name.equals("stone")||name.equals("dirt"))?1:16);meta++)for(int f:new int[]{0,1,3,10})for(int seed=0;seed<32;seed++){Random nr=new Random(seed),lr=new Random(seed);Item it=b.getItemDropped(b.getStateFromMeta(meta),nr,f);Object olditem=invoke(oldDrop,o,meta,lr,f);int oldid=(Integer)oi.getMethod("b",oi).invoke(null,olditem);check(Item.getIdFromItem(it)==oldid&&nr.nextLong()==lr.nextLong(),"actual vanilla original/native drop parity "+name);nr=new Random(seed);lr=new Random(seed);check(b.quantityDroppedWithBonus(f,nr)==(Integer)invoke(oldQuantity,o,f,lr)&&nr.nextLong()==lr.nextLong(),"actual vanilla fortune/RNG parity "+name);}}}
 static final class NativeWorld extends World {
  final Map<Long,Chunk> chunks=new HashMap<>();final List<ItemStack> spawned=new ArrayList<>();NativeWorld(){super(new SaveHandlerMP(),new WorldInfo(new NBTTagCompound()),new WorldProviderSurface(),new Profiler(),false);provider.setWorld(this);chunkProvider=createChunkProvider();for(int x=-1;x<=1;x++)for(int z=-1;z<=1;z++){Chunk c=new Chunk(this,x,z);c.markLoaded(true);chunks.put(key(x,z),c);}}
  static long key(int x,int z){return ((long)x<<32)^(z&0xffffffffL);}protected IChunkProvider createChunkProvider(){return new IChunkProvider(){public Chunk getLoadedChunk(int x,int z){return chunks.get(key(x,z));}public Chunk provideChunk(int x,int z){return getLoadedChunk(x,z);}public boolean tick(){return false;}public String makeString(){return "real preloaded chunks";}public boolean isChunkGeneratedAt(int x,int z){return getLoadedChunk(x,z)!=null;}};}protected boolean isChunkLoaded(int x,int z,boolean empty){return chunks.containsKey(key(x,z));}public boolean checkLight(BlockPos p){return true;}
  @Override public boolean spawnEntity(Entity e){if(e instanceof EntityItem){spawned.add(((EntityItem)e).getItem().copy());return true;}return super.spawnEntity(e);}
 }
}
