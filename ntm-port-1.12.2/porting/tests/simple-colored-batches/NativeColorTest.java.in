 static void current(){GlStateManager.resetColor();GlStateManager.color(.23F,.47F,.61F,.83F);}
 static void compare(Tessellator owner,Legacy old,String label)throws Exception{
  BufferBuilder b=owner.getBuffer();int count=(Integer)get(old.actual,"g");
  if(count!=b.getVertexCount() || (Integer)get(old.actual,"s")!=b.getDrawMode())throw new AssertionError(label+" count/mode");
  if((Boolean)get(old.actual,"m") || !(Boolean)get(old.actual,"l") || (Boolean)get(old.actual,"n") || (Boolean)get(old.actual,"o"))throw new AssertionError(label+" old attributes");
  if(!b.getVertexFormat().equals(DefaultVertexFormats.POSITION_COLOR) || b.getVertexFormat().getSize()!=16)throw new AssertionError(label+" format");
  int[] raw=(int[])get(old.actual,"f");ByteBuffer bytes=b.getByteBuffer().duplicate().order(ByteOrder.nativeOrder());bytes.clear();
  for(int v=0;v<count;v++){
   for(int c=0;c<3;c++)if(raw[v*8+c]!=bytes.getInt(v*16+c*4))throw new AssertionError(label+" position "+v+"/"+c);
   if(raw[v*8+5]!=bytes.getInt(v*16+12))throw new AssertionError(label+" RGBA "+v+": "+Integer.toHexString(raw[v*8+5])+" != "+Integer.toHexString(bytes.getInt(v*16+12)));
  }
