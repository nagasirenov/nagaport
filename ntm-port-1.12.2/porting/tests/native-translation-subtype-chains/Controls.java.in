package com.hbm.items;
import com.hbm.items.armor.ArmorFSB;
import net.minecraft.item.Item;
import net.minecraft.item.ItemArmor.ArmorMaterial;
class Controls {
 static class Child extends ArmorFSB {Child(){super(ArmorMaterial.IRON,1,"x");}}
 static class ReturnsOther extends Child {public ArmorFSB cloneStats(ArmorFSB a){return a;}}
 static class LegacySetter extends Child {public Item setUnlocalizedName(String a){return this;}}
 static class ModernSetter extends Child {public Item setTranslationKey(String a){return this;}}
 static Child factory(){return new Child();}
 void test(Child dynamic) {
 new Child().cloneStats(dynamic).setUnlocalizedName("yes");
 dynamic.cloneStats(dynamic).setUnlocalizedName("no-dynamic");
 factory().cloneStats(dynamic).setUnlocalizedName("no-factory");
 new Child(){}.cloneStats(dynamic).setUnlocalizedName("no-anonymous");
 new ReturnsOther().cloneStats(dynamic).setUnlocalizedName("no-return-other");
 new LegacySetter().cloneStats(dynamic).setUnlocalizedName("no-legacy-override");
 new ModernSetter().cloneStats(dynamic).setUnlocalizedName("no-modern-override");
 new Child().cloneStats(dynamic).setUnlocalizedName(7);
 }
}
