/** Independent legacy selectors and OBJ text oracle versus actual production BakedQuad bytes. */
public final class ThermalBlockModelNativeTest {
 static int checks; static Unsafe unsafe; static SimpleReloadableResourceManager sharedResources;
 static final Map<String,TextureAtlasSprite> sprites=new LinkedHashMap<>();
 static void check(boolean value,String message){checks++;if(!value)throw new AssertionError(message);}
 static void close(float got,float want,String message){check(Math.abs(got-want)<0.000003F,message+": "+got+" != "+want);}
 static void set(Object o,Class<?> c,String field,Object value)throws Exception{Field f=c.getDeclaredField(field);f.setAccessible(true);f.set(o,value);}
 static Object get(Object o,Class<?> c,String field)throws Exception{Field f=c.getDeclaredField(field);f.setAccessible(true);return f.get(o);}
 static final class Sprite extends TextureAtlasSprite {
  Sprite(String name,int index){super(name);setIconWidth(16);setIconHeight(16);initSprite(512,64,16*index,16,false);}
 }
 static TextureAtlasSprite sprite(String name){TextureAtlasSprite s=sprites.get(name);if(s==null){s=new Sprite(name,sprites.size());sprites.put(name,s);}return s;}
 static String expected(Family family,boolean active,boolean item,boolean covered,int meta,EnumFacing face){
  // Transcribed independently from pinned pristine registerBlockIcons/getIcon methods.
  int side=face.getIndex();boolean front=meta==0&&side==3||side==meta;String on=active?"on":"off",s;
  switch(family){
   case BRICK:s=front?"machine_furnace_brick_front_"+on:side==1?"machine_furnace_brick_top":side==0?"machine_furnace_brick_bottom":"machine_furnace_brick_side";break;
   case RTG:s=front?"machine_rtg_furnace_"+on+"_alt":side==0||side==1?"machine_rtg_furnace_base_alt":"machine_rtg_furnace_side_alt";break;
   case RTG_DIFURNACE:s=front?"rtg_difurnace_front_"+on:side==1?"rtg_difurnace_top_"+on:"machine_rtg_furnace_side_alt";break;
   case DIFURNACE:
    if(!item&&side==0)s="brick_fire";
    else if(!item&&covered)s=front?"difurnace_front_"+on+"_tall":side==1?"brick_fire":"difurnace_side_tall";
    else s=front?"difurnace_front_"+on+"_alt":side==1?"difurnace_top_"+on+"_alt":"difurnace_side_alt";
    break;
   default:throw new AssertionError(family);
  }
  return "hbm:blocks/"+s;
 }
 static float[] oldUV(EnumFacing face,float x,float y,float z){switch(face){
  case DOWN:case UP:return new float[]{x,z};case NORTH:return new float[]{1-x,1-y};case SOUTH:return new float[]{x,1-y};case WEST:return new float[]{z,1-y};case EAST:return new float[]{1-z,1-y};default:throw new AssertionError(face);
 }}
 static void cube(IBakedModel model,Family family,boolean active,boolean item,boolean covered,int meta){
  String context=family+":"+active+":"+item+":"+covered+":"+meta;
  check(model.isAmbientOcclusion()&&model.isGui3d()&&!model.isBuiltInRenderer(),context+" native lit 3D cube");
  check(model.getQuads(null,null,0).isEmpty(),context+" no duplicate general faces");
  check(model.getParticleTexture().getIconName().equals(expected(family,active,true,false,meta,EnumFacing.DOWN)),context+" context-free original particle selector");
  close(model.getItemCameraTransforms().gui.scale.x,.625F,context+" native GUI scale");close(model.getItemCameraTransforms().gui.rotation.y,225,context+" native GUI angle");
  check(model.getOverrides().getOverrides().isEmpty(),context+" no invented overrides");
  int count=0;
  for(EnumFacing face:EnumFacing.values()){
   List<BakedQuad> quads=model.getQuads(null,face,0);check(quads.size()==1,context+" one culled quad "+face);count+=quads.size();BakedQuad q=quads.get(0);
   check(q.getSprite().getIconName().equals(expected(family,active,item,covered,meta,face)),context+" independent legacy texture "+face);
   check(q.getFace()==face&&q.shouldApplyDiffuseLighting()&&!q.hasTintIndex(),context+" direction/diffuse/no tint");
   check(q.getFormat().equals(DefaultVertexFormats.ITEM),context+" native ITEM vertex layout");
   int stride=q.getFormat().getIntegerSize();int[] d=q.getVertexData();check(stride==7&&d.length==28,context+" four-vertex quad");Set<String> points=new HashSet<>();float[][] xyz=new float[4][3];
   for(int v=0;v<4;v++){
    int k=v*stride;float x=Float.intBitsToFloat(d[k]),y=Float.intBitsToFloat(d[k+1]),z=Float.intBitsToFloat(d[k+2]);xyz[v]=new float[]{x,y,z};
    for(float value:xyz[v])check(value==0||value==1,context+" full cube bound");check(points.add(x+","+y+","+z),context+" distinct corner");
    close(face.getAxis()==EnumFacing.Axis.X?x:face.getAxis()==EnumFacing.Axis.Y?y:z,face.getAxisDirection()==EnumFacing.AxisDirection.POSITIVE?1:0,context+" plane");
    float[] uv=oldUV(face,x,y,z);
    // Native FaceBakery insets standard cube UVs 0.1%; no rotation/mirroring changes.
    close(Float.intBitsToFloat(d[k+4]),q.getSprite().getInterpolatedU(16*(uv[0]*.998F+.001F)),context+" pristine cube U "+face);
    close(Float.intBitsToFloat(d[k+5]),q.getSprite().getInterpolatedV(16*(uv[1]*.998F+.001F)),context+" pristine cube V "+face);
    int normal=d[k+6];check((byte)normal==127*face.getXOffset()&&(byte)(normal>>8)==127*face.getYOffset()&&(byte)(normal>>16)==127*face.getZOffset(),context+" packed native normals");
   }
   float ax=xyz[1][0]-xyz[0][0],ay=xyz[1][1]-xyz[0][1],az=xyz[1][2]-xyz[0][2],bx=xyz[2][0]-xyz[0][0],by=xyz[2][1]-xyz[0][1],bz=xyz[2][2]-xyz[0][2];
   close((ay*bz-az*by)*face.getXOffset()+(az*bx-ax*bz)*face.getYOffset()+(ax*by-ay*bx)*face.getZOffset(),1,context+" outward winding");
  }
  check(count==6,context+" item traversal totals six not twelve");
 }
 static final class OracleFace {String group;float[][] position=new float[3][3],uv=new float[3][2];float[] normal;}
 static List<OracleFace> legacyObj(Reader source)throws Exception{
  // Independent minimal oracle parses original file directly, never reads ObjMesh faces.
  List<float[]> vertices=new ArrayList<>(),uvs=new ArrayList<>();List<OracleFace> faces=new ArrayList<>();BufferedReader in=new BufferedReader(source);String line,group="";
  while((line=in.readLine())!=null){String[] p=line.trim().split("\\s+");if(p[0].equals("o"))group=p[1];
   else if(p[0].equals("v"))vertices.add(new float[]{Float.parseFloat(p[1]),Float.parseFloat(p[2]),Float.parseFloat(p[3])});
   else if(p[0].equals("vt"))uvs.add(new float[]{Float.parseFloat(p[1]),1-Float.parseFloat(p[2])});
   else if(p[0].equals("f")){check(p.length==4,"pristine extension uses triangles");OracleFace f=new OracleFace();f.group=group;
    for(int i=0;i<3;i++){String[] k=p[i+1].split("/");f.position[i]=vertices.get(Integer.parseInt(k[0])-1);f.uv[i]=uvs.get(Integer.parseInt(k[1])-1);}
    double ax=f.position[1][0]-f.position[0][0],ay=f.position[1][1]-f.position[0][1],az=f.position[1][2]-f.position[0][2];
    double bx=f.position[2][0]-f.position[0][0],by=f.position[2][1]-f.position[0][1],bz=f.position[2][2]-f.position[0][2];
    double nx=ay*bz-az*by,ny=az*bx-ax*bz,nz=ax*by-ay*bx,length=(float)Math.sqrt(nx*nx+ny*ny+nz*nz);
    f.normal=new float[]{(float)(nx/length),(float)(ny/length),(float)(nz/length)};faces.add(f);
   }
  }
  check(faces.size()==20,"original extension exactly twenty triangles");return faces;
 }
 static void extension(IBakedModel model,boolean item,List<OracleFace> oracle){
  check(!model.isAmbientOcclusion()&&model.isGui3d()&&!model.isBuiltInRenderer(),"extension non-AO native model");
  for(EnumFacing face:EnumFacing.values())check(model.getQuads(null,face,0).isEmpty(),"extension no accidental face culling");
  List<BakedQuad> quads=model.getQuads(null,null,0);check(quads.size()==oracle.size(),"extension twenty general quads");
  for(int f=0;f<oracle.size();f++){
   OracleFace want=oracle.get(f);BakedQuad q=quads.get(f);String name="hbm:blocks/"+(want.group.equals("Top")?"difurnace_top_off_alt":want.group.equals("Bottom")?"brick_fire":"difurnace_extension");
   check(q.getSprite().getIconName().equals(name),"original OBJ group sprite");check(q.shouldApplyDiffuseLighting()==item,"world custom shade only; item native diffuse");
   check(q.getFormat().equals(item?DefaultVertexFormats.ITEM:DefaultVertexFormats.BLOCK)&&q.getVertexData().length==28,"native extension vertex layout");
   int[] data=q.getVertexData();float brightness=item?1F:Math.max(.45F,want.normal[1]*.3F+.7F-Math.abs(want.normal[0])*.1F+Math.abs(want.normal[2])*.1F);
   int color=(int)(brightness*255F);
   for(int v=0;v<4;v++){int k=7*v,j=Math.min(v,2);float[] p=want.position[j],uv=want.uv[j];
    close(Float.intBitsToFloat(data[k]),p[0]+.5F,"OBJ x + original world translation");close(Float.intBitsToFloat(data[k+1]),p[1],"OBJ y unchanged");close(Float.intBitsToFloat(data[k+2]),p[2]+.5F,"OBJ z + original world translation");
    close(Float.intBitsToFloat(data[k+4]),q.getSprite().getInterpolatedU(uv[0]*16D),"OBJ exact U, no cube inset");close(Float.intBitsToFloat(data[k+5]),q.getSprite().getInterpolatedV(uv[1]*16D),"OBJ original loader V flip, no cube inset");
    int c=data[k+3];check((c&255)==color&&((c>>8)&255)==color&&((c>>16)&255)==color&&((c>>>24)&255)==255,"original world/item per-face shadow bytes");
    int n=data[k+6];if(item)check((byte)n==(byte)(want.normal[0]*127F)&&(byte)(n>>8)==(byte)(want.normal[1]*127F)&&(byte)(n>>16)==(byte)(want.normal[2]*127F),"normalized original cross-product normal, not rounded OBJ vn");
   }
   for(int offset=0;offset<7;offset++)check(data[14+offset]==data[21+offset],"original triangle-to-quad duplicates third vertex");
  }
 }
 static final class LightingWorld implements net.minecraft.world.IBlockAccess {
  final net.minecraft.util.math.BlockPos pos=new net.minecraft.util.math.BlockPos(8,64,8);
  final int own=0x00A00070;
  public net.minecraft.tileentity.TileEntity getTileEntity(net.minecraft.util.math.BlockPos p){return null;}
  public int getCombinedLight(net.minecraft.util.math.BlockPos p,int emission){if(p.equals(pos))return own;return 0x00100010*((Math.abs(p.getX()+2*p.getY()+3*p.getZ())%8)+1);}
  public IBlockState getBlockState(net.minecraft.util.math.BlockPos p){return p.equals(pos)?ThermalBlockNativeTest.extension.getDefaultState():net.minecraft.init.Blocks.STONE.getDefaultState();}
  public boolean isAirBlock(net.minecraft.util.math.BlockPos p){return false;}
  public net.minecraft.world.biome.Biome getBiome(net.minecraft.util.math.BlockPos p){return net.minecraft.init.Biomes.PLAINS;}
  public int getStrongPower(net.minecraft.util.math.BlockPos p,EnumFacing side){return 0;}
  public net.minecraft.world.WorldType getWorldType(){return net.minecraft.world.WorldType.DEFAULT;}
  public boolean isSideSolid(net.minecraft.util.math.BlockPos p,EnumFacing side,boolean fallback){return !p.equals(pos);}
 }
 static void lighting(IBakedModel model){
  LightingWorld world=new LightingWorld();IBlockState state=ThermalBlockNativeTest.extension.getDefaultState();
  net.minecraft.client.renderer.color.BlockColors colors=new net.minecraft.client.renderer.color.BlockColors();
  for(boolean forge:new boolean[]{false,true}){
   net.minecraft.client.renderer.BufferBuilder out=new net.minecraft.client.renderer.BufferBuilder(4096);out.begin(7,DefaultVertexFormats.BLOCK);
   if(forge){
    net.minecraftforge.client.model.pipeline.VertexLighterFlat lighter=new net.minecraftforge.client.model.pipeline.VertexLighterFlat(colors);
    net.minecraftforge.client.model.pipeline.VertexBufferConsumer consumer=new net.minecraftforge.client.model.pipeline.VertexBufferConsumer(out);consumer.setOffset(world.pos);
    lighter.setParent(consumer);lighter.setWorld(world);lighter.setState(state);lighter.setBlockPos(world.pos);lighter.updateBlockInfo();
    for(BakedQuad q:model.getQuads(state,null,0))q.pipe(lighter);lighter.resetBlockInfo();
   }else check(new net.minecraft.client.renderer.BlockModelRenderer(colors).renderModelFlat(world,model,state,world.pos,out,true,0),"native vanilla flat fallback emits model");
   out.finishDrawing();check(out.getVertexCount()==80,"twenty extension triangles emitted as native quads "+forge);
   java.nio.ByteBuffer bytes=out.getByteBuffer();
   for(int v=0;v<80;v++){
    check(bytes.getInt(v*28+24)==world.own,"native "+(forge?"Forge VertexLighterFlat":"vanilla flat")+" light samples block, not differently-lit neighbors at vertex "+v+": "+Integer.toHexString(bytes.getInt(v*28+24)));
    int expected=model.getQuads(state,null,0).get(v/4).getVertexData()[(v%4)*7+3];
    check(bytes.getInt(v*28+12)==expected,"native renderer preserves original precomputed shadow without double diffuse "+forge);
   }
  }
 }
 static Reader reader(IResourcePack pack,ResourceLocation id)throws Exception {check(pack.resourceExists(id),"resource exists "+id);return new InputStreamReader(pack.getInputStream(id),StandardCharsets.UTF_8);}
 static void direct(IResourcePack pack)throws Exception {
  ResourceLocation obj=new ResourceLocation("hbm","models/blocks/difurnace_extension.obj");ObjMesh mesh;List<OracleFace> oracle;
  try(Reader r=reader(pack,obj)){mesh=ObjMeshParser.parse(r,obj.toString(),false);}try(Reader r=reader(pack,obj)){oracle=legacyObj(r);}
  for(boolean item:new boolean[]{false,true}){IBakedModel model=new DiFurnaceExtensionBakedModel(mesh,item,ThermalBlockModelNativeTest::sprite);extension(model,item,oracle);if(!item)lighting(model);}
  for(Family family:Family.values())for(boolean active:new boolean[]{false,true})for(boolean item:new boolean[]{false,true})for(boolean covered:new boolean[]{false,true})for(int meta=0;meta<16;meta++){
   IBakedModel model=new ThermalFurnaceBakedModel(family,active,item,meta,covered,ThermalBlockModelNativeTest::sprite);cube(model,family,active,item,covered,meta);
  }
  for(String name:sprites.keySet()){ResourceLocation id=new ResourceLocation(name),png=new ResourceLocation(id.getNamespace(),"textures/"+id.getPath()+".png");check(pack.resourceExists(png),"exact-case packaged texture exists "+png);try(InputStream in=pack.getInputStream(png)){check(ImageIO.read(in)!=null,"actual texture decodes "+png);}}
 }
 static void event(Class<?> type,Object event)throws Exception {
  int count=0;for(Method m:ThermalFurnaceModelHandler.class.getDeclaredMethods())if(m.isAnnotationPresent(SubscribeEvent.class)&&Arrays.equals(m.getParameterTypes(),new Class<?>[]{type})){
   check(Modifier.isStatic(m.getModifiers()),"static native event subscriber "+type);m.setAccessible(true);m.invoke(null,event);count++;
  }check(count==1,"one subscribed native event "+type);
 }
 static final class ChangedObjPack implements IResourcePack {
  final IResourcePack original;ChangedObjPack(IResourcePack pack){original=pack;}
  public InputStream getInputStream(ResourceLocation id)throws IOException {
   if(!id.equals(new ResourceLocation("hbm","models/blocks/difurnace_extension.obj")))return original.getInputStream(id);
   ByteArrayOutputStream bytes=new ByteArrayOutputStream();try(InputStream in=original.getInputStream(id)){byte[] buffer=new byte[4096];int n;while((n=in.read(buffer))!=-1)bytes.write(buffer,0,n);}
   String text=new String(bytes.toByteArray(),StandardCharsets.UTF_8).replace("v -0.250000 1.000000 -0.250000","v -0.125000 1.000000 -0.250000");return new ByteArrayInputStream(text.getBytes(StandardCharsets.UTF_8));
  }
  public boolean resourceExists(ResourceLocation id){return original.resourceExists(id);}
  public Set<String> getResourceDomains(){return original.getResourceDomains();}
  public <T extends net.minecraft.client.resources.data.IMetadataSection>T getPackMetadata(MetadataSerializer m,String key)throws IOException{return original.getPackMetadata(m,key);}
  public java.awt.image.BufferedImage getPackImage()throws IOException{return original.getPackImage();}
  public String getPackName(){return "Controlled changed OBJ resource for native reload test";}
 }
 static IBakedModel bake(ResourceLocation location,boolean item)throws Exception {
  net.minecraftforge.client.model.IModel model=net.minecraftforge.client.model.ModelLoaderRegistry.getModel(location);
  check(model!=net.minecraftforge.client.model.ModelLoaderRegistry.getMissingModel(),"real custom model, never missing placeholder "+location);
  check(model.getDependencies().isEmpty(),"self-contained thermal geometry");
  for(ResourceLocation texture:model.getTextures())check(sprites.containsKey(texture.toString()),"native loader advertises actual sprite "+texture);
  IBakedModel baked=model.bake(model.getDefaultState(),item?DefaultVertexFormats.ITEM:DefaultVertexFormats.BLOCK,resource->sprite(resource.toString()));
  Set<ResourceLocation> needed=new HashSet<>();needed.add(new ResourceLocation(baked.getParticleTexture().getIconName()));
  for(EnumFacing face:EnumFacing.values())for(BakedQuad q:baked.getQuads(null,face,0))needed.add(new ResourceLocation(q.getSprite().getIconName()));
  for(BakedQuad q:baked.getQuads(null,null,0))needed.add(new ResourceLocation(q.getSprite().getIconName()));
  check(needed.equals(new HashSet<ResourceLocation>(model.getTextures())),"complete exact native atlas dependency collection "+location);
  return baked;
 }
 static void registry(IResourcePack pack)throws Exception{
  Mod.EventBusSubscriber ann=ThermalFurnaceModelHandler.class.getAnnotation(Mod.EventBusSubscriber.class);
  check(ann!=null&&ann.modid().equals("hbm")&&Arrays.equals(ann.value(),new Side[]{Side.CLIENT}),"client-only automatic model handler");
  if(sharedResources==null){sharedResources=new SimpleReloadableResourceManager(new MetadataSerializer());Minecraft minecraft=(Minecraft)unsafe.allocateInstance(Minecraft.class);set(null,Minecraft.class,"instance",minecraft);set(minecraft,Minecraft.class,"resourceManager",sharedResources);}
  SimpleReloadableResourceManager resources=sharedResources;resources.reloadResources(Collections.singletonList(pack));
  // Native ModelLoader initialization is CPU-only before setupModelRegistry's GL atlas upload.
  net.minecraft.launchwrapper.Launch.blackboard=new HashMap<String,Object>();net.minecraft.launchwrapper.Launch.blackboard.put("fml.deobfuscatedEnvironment",Boolean.TRUE);
  TextureMap atlas=new TextureMap("textures");ModelManager loaderManager=new ModelManager(atlas);
  new ModelLoader(resources,atlas,new net.minecraft.client.renderer.BlockModelShapes(loaderManager));
  event(ModelRegistryEvent.class,new ModelRegistryEvent());
  resources.reloadResources(Collections.singletonList(pack));
  net.minecraftforge.client.model.ModelLoaderRegistry.clearModelCache(resources);
  Map<?,?> custom=(Map<?,?>)get(null,ModelLoader.class,"customModels");
  check(custom.size()==144,"all nine block item identities have sixteen native metadata registrations");
  RegistrySimple<ModelResourceLocation,IBakedModel> baked=new RegistrySimple<>();ModelManager manager=(ModelManager)unsafe.allocateInstance(ModelManager.class);
  List<OracleFace> oracle;try(Reader r=reader(pack,new ResourceLocation("hbm","models/blocks/difurnace_extension.obj"))){oracle=legacyObj(r);}
  int worldCount=0;
  for(int f=0;f<4;f++)for(int active=0;active<2;active++){
   Block b=ThermalBlockNativeTest.blocks[f][active];Map<IBlockState,ModelResourceLocation> mapping=new DefaultStateMapper().putStateModelLocations(b);
   check(mapping.size()==(f==3?32:16),"native state space includes every raw metadata/covered combination");
   ModelBlockDefinition definition;try(Reader r=reader(pack,new ResourceLocation("hbm","blockstates/"+b.getRegistryName().getPath()+".json"))){definition=ModelBlockDefinition.parseFromReader(r,b.getRegistryName());}
   for(Map.Entry<IBlockState,ModelResourceLocation> e:mapping.entrySet()){
    check(definition.hasVariant(e.getValue().getVariant()),"packaged exact native state variant "+e.getValue());
    List<Variant> variants=definition.getVariant(e.getValue().getVariant()).getVariantList();check(variants.size()==1,"single custom model, no weighted substitution");Variant v=variants.get(0);
    check(v.getRotation()==ModelRotation.X0_Y0&&!v.isUvLock(),"no extra model geometry/UV rotation");
    IBakedModel model=bake(v.getModelLocation(),false);baked.putObject(e.getValue(),model);
    cube(model,Family.values()[f],active==1,false,f==3&&e.getKey().getValue(MachineDiFurnace.COVERED),b.getMetaFromState(e.getKey()));worldCount++;
   }
   for(int meta=0;meta<16;meta++){
    Item item=Item.getItemFromBlock(b);ModelResourceLocation id=(ModelResourceLocation)custom.get(Pair.of(item.delegate,meta));check(id!=null,"native item registration key "+meta);IBakedModel model=bake(id,true);baked.putObject(id,model);cube(model,Family.values()[f],active==1,true,false,meta);
   }
  }
  Block extension=ThermalBlockNativeTest.extension;ModelBlockDefinition definition;
  try(Reader r=reader(pack,new ResourceLocation("hbm","blockstates/"+extension.getRegistryName().getPath()+".json"))){definition=ModelBlockDefinition.parseFromReader(r,extension.getRegistryName());}
  for(ModelResourceLocation id:new DefaultStateMapper().putStateModelLocations(extension).values()){
   check(definition.hasVariant(id.getVariant()),"extension JSON covers exact native state");List<Variant> variants=definition.getVariant(id.getVariant()).getVariantList();check(variants.size()==1,"extension single unchanged geometry");
   IBakedModel model=bake(variants.get(0).getModelLocation(),false);baked.putObject(id,model);extension(model,false,oracle);lighting(model);worldCount++;
  }
  for(int meta=0;meta<16;meta++){Item item=Item.getItemFromBlock(extension);ModelResourceLocation id=(ModelResourceLocation)custom.get(Pair.of(item.delegate,meta));check(id!=null,"extension all item metadata");IBakedModel model=bake(id,true);baked.putObject(id,model);extension(model,true,oracle);}
  check(worldCount>=161,"all real thermal block state models registered");
  set(manager,ModelManager.class,"modelRegistry",baked);ItemModelMesher mesher=new ItemModelMesher(manager);ModelLoader.onRegisterItems(mesher);mesher.rebuildCache();
  List<Block> all=new ArrayList<>();for(Block[] pair:ThermalBlockNativeTest.blocks)all.addAll(Arrays.asList(pair));all.add(extension);
  for(Block b:all)for(int meta=0;meta<16;meta++){Item item=Item.getItemFromBlock(b);ModelResourceLocation id=(ModelResourceLocation)custom.get(Pair.of(item.delegate,meta));check(mesher.getItemModel(new ItemStack(item,1,meta))==baked.getObject(id),"actual native ItemModelMesher metadata routing");}
  ModelResourceLocation id=(ModelResourceLocation)custom.values().iterator().next();net.minecraftforge.client.model.IModel old=net.minecraftforge.client.model.ModelLoaderRegistry.getModel(id);
  resources.reloadResources(Collections.singletonList(pack));net.minecraftforge.client.model.ModelLoaderRegistry.clearModelCache(resources);
  check(net.minecraftforge.client.model.ModelLoaderRegistry.getModel(id)!=old,"resource reload replaces old unbaked model cache");
  ModelResourceLocation extensionId=(ModelResourceLocation)custom.get(Pair.of(Item.getItemFromBlock(extension).delegate,0));
  close(Float.intBitsToFloat(bake(extensionId,true).getQuads(null,null,0).get(0).getVertexData()[0]),.25F,"pristine OBJ before resource reload");
