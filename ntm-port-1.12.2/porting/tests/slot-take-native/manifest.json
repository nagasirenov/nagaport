    {
      "path": "ntm-port-1.12.2/src/main/java/com/hbm/inventory/container/ContainerAnvil.java",
      "before_sha256": "75779bb286b6ed2b9a66e30cdb05a512ae0c50784400469ce1f0fbb469338628",
      "after_sha256": "c5827e6e9c8b2d53cba84437f272ed1391c40aa2393de34aa137a37a07199220",
      "edits": [
        {
          "start": 1133,
          "end": 1858,
          "old": "public void onPickupFromSlot(EntityPlayer player, ItemStack stack) {\n\t\t\t\tsuper.onPickupFromSlot(player, stack);\n\t\t\t\t\n\t\t\t\tItemStack left = ContainerAnvil.this.input.getStackInSlot(0);\n\t\t\t\tItemStack right = ContainerAnvil.this.input.getStackInSlot(1);\n\t\t\t\t\n\t\t\t\tif(left == null || right == null) {\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tfor(com.hbm.inventory.recipes.anvil.AnvilSmithingRecipe rec : AnvilRecipes.getSmithing()) {\n\t\t\t\t\t\n\t\t\t\t\tint i = rec.matchesInt(left, right);\n\t\t\t\t\t\n\t\t\t\t\tif(i != -1) {\n\t\t\t\t\t\tContainerAnvil.this.input.decrStackSize(0, rec.amountConsumed(0, i == 1));\n\t\t\t\t\t\tContainerAnvil.this.input.decrStackSize(1, rec.amountConsumed(1, i == 1));\n\t\t\t\t\t\tContainerAnvil.this.updateSmithing();\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}",
          "new": "public ItemStack onTake(EntityPlayer player, ItemStack stack) {\n\t\t\t\tsuper.onTake(player, stack);\n\t\t\t\t\n\t\t\t\tItemStack left = ContainerAnvil.this.input.getStackInSlot(0);\n\t\t\t\tItemStack right = ContainerAnvil.this.input.getStackInSlot(1);\n\t\t\t\t\n\t\t\t\tif(left == null || right == null) {\n\t\t\t\t\treturn stack;\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\tfor(com.hbm.inventory.recipes.anvil.AnvilSmithingRecipe rec : AnvilRecipes.getSmithing()) {\n\t\t\t\t\t\n\t\t\t\t\tint i = rec.matchesInt(left, right);\n\t\t\t\t\t\n\t\t\t\t\tif(i != -1) {\n\t\t\t\t\t\tContainerAnvil.this.input.decrStackSize(0, rec.amountConsumed(0, i == 1));\n\t\t\t\t\t\tContainerAnvil.this.input.decrStackSize(1, rec.amountConsumed(1, i == 1));\n\t\t\t\t\t\tContainerAnvil.this.updateSmithing();\n\t\t\t\t\t\treturn stack;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\treturn stack;\n\t\t\t}",
          "kind": "callback"
        },
        {
          "start": 2862,
          "end": 2878,
          "old": "onPickupFromSlot",
          "new": "onTake",
          "kind": "call"
        },
