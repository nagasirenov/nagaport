import java.util.*;
/** Executes the pristine renderer selectors and GL order, with descriptor-only stand-ins. */
final class LegacySplitterOracle {
 static int mask,meta;static boolean item;static List<Layer> layers;
 static class Layer {String part;int sprite,face=-1;double[] box,matrix;double tx,ty,tz;float rotation;boolean shadow;}
 static List<Layer> layers(boolean inventory,int metadata){meta=metadata;item=inventory;layers=new ArrayList<>();GL11.matrix=identity();Tessellator.instance.tx=Tessellator.instance.ty=Tessellator.instance.tz=0;
  LegacySplitterOracle oracle=new LegacySplitterOracle();if(item)oracle.renderInventoryBlock(new OracleBlock(0),meta,0,new RenderBlocks());else oracle.renderWorldBlock(new OracleWorld(),0,0,0,new OracleBlock(0),0,new RenderBlocks());return layers;}
 static double[] identity(){double[] m=new double[16];for(int i=0;i<4;i++)m[i*5]=1;return m;}
 static double[] multiply(double[] a,double[] b){double[] r=new double[16];for(int y=0;y<4;y++)for(int x=0;x<4;x++)for(int k=0;k<4;k++)r[y*4+x]+=a[y*4+k]*b[k*4+x];return r;}
 static class GL11 {static double[] matrix=identity();static final Deque<double[]> stack=new ArrayDeque<>();static void glPushMatrix(){stack.push(matrix.clone());}static void glPopMatrix(){matrix=stack.pop();}static void glRotatef(float angle,float x,float y,float z){glRotated(angle,x,y,z);}static void glRotated(double angle,double x,double y,double z){if(y!=1||x!=0||z!=0)throw new AssertionError();double[] m=identity();double c=Math.cos(Math.toRadians(angle)),s=Math.sin(Math.toRadians(angle));if(Math.abs(c)<1E-15)c=0;if(Math.abs(s)<1E-15)s=0;m[0]=c;m[2]=s;m[8]=-s;m[10]=c;matrix=multiply(matrix,m);}static void glScaled(double x,double y,double z){double[] m=identity();m[0]=x;m[5]=y;m[10]=z;matrix=multiply(matrix,m);}static void glTranslatef(float x,float y,float z){double[] m=identity();m[3]=x;m[7]=y;m[11]=z;matrix=multiply(matrix,m);}}
 static class OracleBlock {int icon;int iconTopLeft=0,iconTopRight=1,iconFrontLeft=2,iconFrontRight=3,iconBackLeft=4,iconBackRight=5,iconLeft=6,iconRight=7,iconBelt=8,iconInner=9,iconInnerSide=10;OracleBlock(int i){icon=i;}int getIcon(int side,int meta){return icon;}void setBlockBoundsForItemRender(){}int getMixedBrightnessForBlock(OracleWorld w,int x,int y,int z){return 0;}}
 static class ModBlocks {static OracleBlock hadron_coil_alloy=new OracleBlock(1),red_cable=new OracleBlock(2);}
 static class OracleWorld {int getBlockMetadata(int x,int y,int z){return meta;}}
 static class Library {static final int POS_X=32,NEG_X=16,POS_Y=8,NEG_Y=4,POS_Z=2,NEG_Z=1;static boolean canConnect(OracleWorld w,int x,int y,int z,int side){return (mask&side)!=0;}}
 static class ResourceManager {static HFRWavefrontObject splitter=new HFRWavefrontObject(),cable_neo=new HFRWavefrontObject(),crane_buffer=new HFRWavefrontObject();}static class HFRWavefrontObject{}
 static class Tessellator {static Tessellator instance=new Tessellator();double tx,ty,tz;void setColorOpaque_F(float a,float b,float c){}void startDrawingQuads(){}void setNormal(float a,float b,float c){}void draw(){}void setBrightness(int a){}void addTranslation(float x,float y,float z){tx+=x;ty+=y;tz+=z;}}
 static class ObjUtil {static void renderPartWithIcon(HFRWavefrontObject mesh,String group,int sprite,Tessellator t,float rotation,boolean shadow){Layer l=new Layer();l.part=group;l.sprite=sprite;l.rotation=rotation;l.shadow=shadow;l.tx=t.tx;l.ty=t.ty;l.tz=t.tz;l.matrix=GL11.matrix.clone();layers.add(l);}}
 static class RenderBlocks {double[] box;int override=-1;void setRenderBoundsFromBlock(OracleBlock b){}void setRenderBounds(double... b){box=b;}void setOverrideBlockTexture(int icon){override=icon;}void clearOverrideBlockTexture(){override=-1;}int getBlockIconFromSideAndMetadata(OracleBlock b,int side,int meta){return b.icon;}
 void renderStandardBlock(OracleBlock b,int x,int y,int z){for(int i=0;i<6;i++)face(i,b.icon);}void face(int side,int icon){Layer l=new Layer();l.face=side;l.box=box.clone();l.sprite=override<0?icon:override;l.matrix=GL11.matrix.clone();layers.add(l);}
 void renderFaceYNeg(OracleBlock b,double x,double y,double z,int icon){face(0,icon);}void renderFaceYPos(OracleBlock b,double x,double y,double z,int icon){face(1,icon);}void renderFaceZNeg(OracleBlock b,double x,double y,double z,int icon){face(2,icon);}void renderFaceZPos(OracleBlock b,double x,double y,double z,int icon){face(3,icon);}void renderFaceXNeg(OracleBlock b,double x,double y,double z,int icon){face(4,icon);}void renderFaceXPos(OracleBlock b,double x,double y,double z,int icon){face(5,icon);}}
 /* METHODS */
}
