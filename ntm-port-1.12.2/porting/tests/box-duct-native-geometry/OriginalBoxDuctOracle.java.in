  int brightnessTopLeft,brightnessBottomLeft,brightnessBottomRight,brightnessTopRight;
  /* NT_FACES */
  double[][] face(Face f){renderMinX=f.bounds[0];renderMinY=f.bounds[1];renderMinZ=f.bounds[2];renderMaxX=f.bounds[3];renderMaxY=f.bounds[4];renderMaxZ=f.bounds[5];uvRotateEast=uvRotateSouth=f.rotation;Tessellator.instance.vertices.clear();if(f.side==2)renderFaceZNeg(null,0,0,0,f.icon);else renderFaceXPos(null,0,0,0,f.icon);return Tessellator.instance.vertices.toArray(new double[0][]);}
 }
