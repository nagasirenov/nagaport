   String[] names={"i","k","m","j","l","n"},rotations={"w","v","r","s","u","t"};for(int i=0;i<6;i++){field(renderer,names[i]).setDouble(render,f.bounds[i]);field(renderer,rotations[i]).setInt(render,f.rotation);}
