 static class RenderBlocks {
  final List<Face> faces=new ArrayList<>();double[] bounds={0,0,0,1,1,1};IBlockAccess world;
  int uvRotateTop,uvRotateBottom,uvRotateNorth,uvRotateSouth,uvRotateEast,uvRotateWest;
  void setRenderBounds(double x0,double y0,double z0,double x1,double y1,double z1){bounds=new double[]{x0,y0,z0,x1,y1,z1};}
  void face(int side,IIcon icon){faces.add(new Face(this,side,icon));}
  void renderStandardBlock(Block b,int x,int y,int z){for(int side=0;side<6;side++)face(side,b.getIcon(world,x,y,z,side));}
  public void renderFaceYNeg(Block b,double x,double y,double z,IIcon i){face(0,i);}public void renderFaceYPos(Block b,double x,double y,double z,IIcon i){face(1,i);}
  public void renderFaceZNeg(Block b,double x,double y,double z,IIcon i){face(2,i);}public void renderFaceZPos(Block b,double x,double y,double z,IIcon i){face(3,i);}
  public void renderFaceXNeg(Block b,double x,double y,double z,IIcon i){face(4,i);}public void renderFaceXPos(Block b,double x,double y,double z,IIcon i){face(5,i);}
 }
 static final class RenderBlocksNT extends RenderBlocks {static RenderBlocksNT INSTANCE=new RenderBlocksNT();RenderBlocksNT setWorld(IBlockAccess w){world=w;return this;}}
 static final class Renderer {/* RENDER */}
 static Layout layout(int kind,int meta,int mask,boolean item,Function<String,TextureAtlasSprite> lookup){
  sprites=lookup;Block owner=kind==0?new FluidDuctBox():kind==1?new FluidDuctBoxExhaust():new PowerCableBox();owner.registerBlockIcons(new IIconRegister());
  RenderBlocksNT.INSTANCE=new RenderBlocksNT();RenderBlocks renderer=item?new RenderBlocks():RenderBlocksNT.INSTANCE;
  IBlockAccess world=new IBlockAccess(meta,mask,kind==0?new TileEntityPipeBaseNT():new TileEntity());
  Tessellator.instance.starts=Tessellator.instance.draws=0;Tessellator.instance.normal=false;
  if(item)new Renderer().renderInventoryBlock(owner,meta,0,renderer);else new Renderer().renderWorldBlock(world,0,0,0,owner,0,renderer);
  if(renderer.uvRotateBottom!=0||renderer.uvRotateTop!=0||renderer.uvRotateEast!=0||renderer.uvRotateWest!=0||renderer.uvRotateNorth!=0||renderer.uvRotateSouth!=0)throw new AssertionError("Original renderer failed rotation reset");
  if(item&&(Tessellator.instance.starts!=1||Tessellator.instance.draws!=1||!Tessellator.instance.normal))throw new AssertionError("Original item batch changed");
  return new Layout(renderer.faces,item||kind==2?0xffffff:FluidDuctBox.cachedColor,item);
 }
 /** Verbatim original two RenderBlocksNT face overrides, without light-solver claims. */
