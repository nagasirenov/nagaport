    if(a!=null&&a.length==1)return m.getName().equals("a")?sprite.getInterpolatedU((Double)a[0]):sprite.getInterpolatedV((Double)a[0]);
    switch(m.getName()){case "a":case "b":return 16;case "c":return sprite.getMinU();case "d":return sprite.getMaxU();case "e":return sprite.getMinV();case "f":return sprite.getMaxV();default:return sprite.getIconName();}
   });
   count.setInt(tess,0);ptr.setInt(tess,0);renderer.getMethod("abcdef".substring(f.side,f.side+1),block,double.class,double.class,double.class,iconType).invoke(render,null,0D,0D,0D,icon);
   if(count.getInt(tess)!=4)throw new AssertionError("Legacy face vertex count");int[] data=(int[])raw.get(tess);double[][] vertices=new double[4][5];for(int i=0;i<4;i++)for(int j=0;j<5;j++)vertices[i][j]=Float.intBitsToFloat(data[i*8+j]);return vertices;
  }
