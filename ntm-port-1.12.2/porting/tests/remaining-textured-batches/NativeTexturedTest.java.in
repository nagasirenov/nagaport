import java.lang.reflect.*;
import java.net.*;
import java.io.*;
import java.nio.*;
import java.util.*;
import net.minecraft.client.renderer.*;
import net.minecraft.client.renderer.vertex.*;
import org.lwjgl.opengl.*;

/** Actual original/native singleton emission and driver execution, not owner-class stubs. */
public final class NativeTexturedTest {
 static Class<?> legacyClass;
 static int batches,vertices,draws,executions;
 static int[] textures=new int[2];
 float zLevel=-90.125F;
 static final class CountRandom extends Random {int calls;CountRandom(long seed){super(seed);}public double nextDouble(){calls++;return super.nextDouble();}}
 static Object get(Object o,String name)throws Exception{Field f=legacyClass.getDeclaredField(name);f.setAccessible(true);return f.get(o);}
 static class Legacy {
  final Object actual;
  Legacy(double t)throws Exception {actual=legacyClass.getField("a").get(null);legacyClass.getMethod("b",double.class,double.class,double.class).invoke(actual,t,-t,t*.25);}
  void startDrawingQuads()throws Exception{legacyClass.getMethod("b").invoke(actual);}
  void setNormal(float x,float y,float z)throws Exception{legacyClass.getMethod("c",float.class,float.class,float.class).invoke(actual,x,y,z);}
  void setBrightness(int v)throws Exception{legacyClass.getMethod("b",int.class).invoke(actual,v);}
  void setColorOpaque_F(float r,float g,float b)throws Exception{legacyClass.getMethod("b",float.class,float.class,float.class).invoke(actual,r,g,b);}
  void setColorRGBA_F(float r,float g,float b,float a)throws Exception{legacyClass.getMethod("a",float.class,float.class,float.class,float.class).invoke(actual,r,g,b,a);}
  void addVertexWithUV(double x,double y,double z,double u,double v)throws Exception{legacyClass.getMethod("a",double.class,double.class,double.class,double.class,double.class).invoke(actual,x,y,z,u,v);}
  void draw()throws Exception{legacyClass.getMethod("a").invoke(actual);}
 }
 static class Record {int count,mode;int[] bytes,state;}
 static void floats(List<Integer> out,int name,int n){FloatBuffer f=org.lwjgl.BufferUtils.createFloatBuffer(16);GL11.glGetFloat(name,f);for(int i=0;i<n;i++)out.add(Float.floatToRawIntBits(f.get(i)));}
 static int[] state(){List<Integer>s=new ArrayList<>();floats(s,GL11.GL_CURRENT_COLOR,4);floats(s,GL11.GL_CURRENT_NORMAL,3);
  for(int v:new int[]{GL11.GL_VERTEX_ARRAY,GL11.GL_COLOR_ARRAY,GL11.GL_NORMAL_ARRAY,GL11.GL_LIGHTING,GL11.GL_BLEND,GL11.GL_CULL_FACE,GL11.GL_ALPHA_TEST,GL11.GL_DEPTH_TEST,GL11.GL_FOG})s.add(GL11.glIsEnabled(v)?1:0);
  for(int v:new int[]{GL11.GL_SHADE_MODEL,GL13.GL_CLIENT_ACTIVE_TEXTURE,GL13.GL_ACTIVE_TEXTURE,GL11.GL_BLEND_SRC,GL11.GL_BLEND_DST,GL11.GL_ALPHA_TEST_FUNC,GL11.GL_MATRIX_MODE})s.add(GL11.glGetInteger(v));
  s.add(GL11.glGetBoolean(GL11.GL_DEPTH_WRITEMASK)?1:0);floats(s,GL11.GL_ALPHA_TEST_REF,1);floats(s,GL11.GL_MODELVIEW_MATRIX,16);floats(s,GL11.GL_PROJECTION_MATRIX,16);
  int active=GL11.glGetInteger(GL13.GL_ACTIVE_TEXTURE),client=GL11.glGetInteger(GL13.GL_CLIENT_ACTIVE_TEXTURE);
  for(int unit:new int[]{GL13.GL_TEXTURE0,GL13.GL_TEXTURE1}){GL13.glActiveTexture(unit);floats(s,GL11.GL_CURRENT_TEXTURE_COORDS,4);s.add(GL11.glGetInteger(GL11.GL_TEXTURE_BINDING_2D));s.add(GL11.glIsEnabled(GL11.GL_TEXTURE_2D)?1:0);GL13.glClientActiveTexture(unit);s.add(GL11.glIsEnabled(GL11.GL_TEXTURE_COORD_ARRAY)?1:0);}
  GL13.glActiveTexture(active);GL13.glClientActiveTexture(client);return s.stream().mapToInt(Integer::intValue).toArray();
 }
 static void enable(int what,boolean enabled){if(enabled)GL11.glEnable(what);else GL11.glDisable(what);}
 static void reset(int seed){
  GlStateManager.resetColor();GlStateManager.color(.23F+seed*.1F,.47F,.61F,seed*.2F);GL11.glNormal3f(.2F,.5F,.8F);
  for(int i=0;i<2;i++){GL13.glActiveTexture(GL13.GL_TEXTURE0+i);GL13.glClientActiveTexture(GL13.GL_TEXTURE0+i);GL11.glDisableClientState(GL11.GL_TEXTURE_COORD_ARRAY);GL11.glBindTexture(GL11.GL_TEXTURE_2D,textures[i]);enable(GL11.GL_TEXTURE_2D,(seed+i)%2==0);GL13.glMultiTexCoord2f(GL13.GL_TEXTURE0+i,.3F+i*37F,.7F+i*19F);}
  GL13.glActiveTexture(GL13.GL_TEXTURE0);GL13.glClientActiveTexture(GL13.GL_TEXTURE0);GL11.glDisableClientState(GL11.GL_VERTEX_ARRAY);GL11.glDisableClientState(GL11.GL_COLOR_ARRAY);GL11.glDisableClientState(GL11.GL_NORMAL_ARRAY);
  enable(GL11.GL_LIGHTING,seed%2==0);enable(GL11.GL_CULL_FACE,seed%3==0);enable(GL11.GL_BLEND,seed%2!=0);enable(GL11.GL_ALPHA_TEST,seed%3!=0);enable(GL11.GL_DEPTH_TEST,seed%2==0);enable(GL11.GL_FOG,seed%3==1);
  GL11.glAlphaFunc(GL11.GL_GREATER,.1F);GL11.glBlendFunc(GL11.GL_SRC_ALPHA,seed%2==0?GL11.GL_ONE:GL11.GL_ONE_MINUS_SRC_ALPHA);GL11.glShadeModel(seed%2==0?GL11.GL_SMOOTH:GL11.GL_FLAT);GL11.glDepthMask(seed%2==0);
  GL11.glMatrixMode(GL11.GL_MODELVIEW);GL11.glLoadIdentity();GL11.glTranslatef(seed*.1F,-seed*.2F,seed*.3F);GL11.glRotatef(seed*17F,1,0,0);GL11.glMatrixMode(GL11.GL_PROJECTION);GL11.glLoadIdentity();GL11.glMatrixMode(GL11.GL_MODELVIEW);
  if(GL11.glGetError()!=0)throw new AssertionError("fixture GL error");
 }
 static void captureNative(Tessellator owner,List<Record> records)throws Exception{
  BufferBuilder b=owner.getBuffer();Record r=new Record();r.count=b.getVertexCount();r.mode=b.getDrawMode();
  if(!b.getVertexFormat().equals(DefaultVertexFormats.POSITION_TEX)||b.getVertexFormat().getSize()!=20)throw new AssertionError("native format");
  r.bytes=new int[r.count*5];ByteBuffer bytes=b.getByteBuffer().duplicate().order(ByteOrder.nativeOrder());bytes.clear();
  for(int v=0;v<r.count;v++)for(int c=0;c<5;c++)r.bytes[v*5+c]=bytes.getInt(v*20+c*4);
  owner.draw();r.state=state();records.add(r);if(b.getVertexCount()!=0)throw new AssertionError("native owner reset");if(GL11.glGetError()!=0)throw new AssertionError("native GL error");draws++;
 }
 static void captureOld(Legacy old,List<Record> records)throws Exception{
  Record r=new Record();r.count=(Integer)get(old.actual,"g");r.mode=(Integer)get(old.actual,"s");
  if(!(Boolean)get(old.actual,"m")||(Boolean)get(old.actual,"l")||(Boolean)get(old.actual,"n")||(Boolean)get(old.actual,"o"))throw new AssertionError("old attribute activation, including discarded pre-begin setters");
  int[] raw=(int[])get(old.actual,"f");r.bytes=new int[r.count*5];for(int v=0;v<r.count;v++)for(int c=0;c<5;c++)r.bytes[v*5+c]=raw[v*8+c];
  old.draw();r.state=state();records.add(r);if((Integer)get(old.actual,"g")!=0)throw new AssertionError("original owner reset");if(GL11.glGetError()!=0)throw new AssertionError("original GL error");draws++;
 }
 static void compare(List<Record> nr,List<Record> or,int nc,int oc,int expectedRng,String label){
  if(nc!=oc||nc!=expectedRng||nr.size()!=or.size())throw new AssertionError(label+" batch/RNG count");
  for(int i=0;i<nr.size();i++){Record n=nr.get(i),o=or.get(i);if(n.count!=o.count||n.mode!=7||o.mode!=7||!Arrays.equals(n.bytes,o.bytes))throw new AssertionError(label+" XYZUV bytes/count/mode "+i);if(!Arrays.equals(n.state,o.state))throw new AssertionError(label+" GL state "+i+"\n"+Arrays.toString(n.state)+"\n"+Arrays.toString(o.state));batches++;vertices+=n.count;}executions++;
 }
 /*METHODS*/
 public static void main(String[] args)throws Exception{
  if(ByteOrder.nativeOrder()!=ByteOrder.LITTLE_ENDIAN)throw new AssertionError("Retained oracle scoped to little-endian Linux/Mesa");
  Constructor<?> c=Class.forName("MaterialTextureAtlasSpriteNativeTest$Context").getDeclaredConstructor();c.setAccessible(true);
  try(AutoCloseable context=(AutoCloseable)c.newInstance();URLClassLoader loader=new URLClassLoader(new URL[]{new File(args[0]).toURI().toURL()},NativeTexturedTest.class.getClassLoader())){
   Method initialize=Class.forName("MaterialTextureAtlasSpriteNativeTest").getDeclaredMethod("initializeNativeClientSettings");initialize.setAccessible(true);initialize.invoke(null);
   OpenGlHelper.initializeTextures();legacyClass=Class.forName("bmh",true,loader);Class.forName("buu",true,loader).getMethod("a").invoke(null);
   for(int i=0;i<2;i++){textures[i]=GL11.glGenTextures();GL11.glBindTexture(GL11.GL_TEXTURE_2D,textures[i]);ByteBuffer pixel=org.lwjgl.BufferUtils.createByteBuffer(4);pixel.putInt(-1).flip();GL11.glTexImage2D(GL11.GL_TEXTURE_2D,0,GL11.GL_RGBA,1,1,0,GL11.GL_RGBA,GL11.GL_UNSIGNED_BYTE,pixel);}
   NativeTexturedTest test=new NativeTexturedTest();
   for(int seed=0;seed<6;seed++)for(double translation:new double[]{0,.125,-16777216.25}){/*CALLS*/}
   if(executions!=522||batches!=522||vertices!=2088||draws!=1044)throw new AssertionError("Incomplete fixture coverage: "+executions+"/"+batches+"/"+vertices+"/"+draws);
   for(int texture:textures)GL11.glDeleteTextures(texture);
   System.out.println("PASS actual original/native singleton POSITION_TEX and Mesa uploads: "+executions+" paired streams, "+batches+" batch comparisons, "+vertices+" vertices, "+draws+" actual draws. Exact XYZUV float words, attribute absence, owner resets, RNG call counts and post-draw GL/current-color/current-normal/UV0/UV1/texture/matrix state. Not full renderer linkage or in-game pixels.");
  }
 }
}
