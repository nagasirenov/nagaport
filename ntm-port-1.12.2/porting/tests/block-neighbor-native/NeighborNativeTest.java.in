import java.util.*;import java.lang.reflect.*;
import net.minecraft.block.*;import net.minecraft.block.material.Material;import net.minecraft.block.state.*;import net.minecraft.entity.Entity;import net.minecraft.init.*;import net.minecraft.util.*;import net.minecraft.util.math.BlockPos;import net.minecraft.world.*;import net.minecraft.world.chunk.*;import net.minecraft.world.storage.*;import net.minecraft.nbt.*;import net.minecraft.profiler.Profiler;import net.minecraftforge.fml.common.*;import net.minecraftforge.fml.common.registry.ForgeRegistries;
public class NeighborNativeTest {
 static int checks,cases,entries;static IBlockState seenState;static World seenWorld;static BlockPos seenPos,seenFrom;static Block seenChanged;static NativeWorld server,client;static final EnumFacing[] POWER={EnumFacing.DOWN,EnumFacing.UP,EnumFacing.NORTH,EnumFacing.SOUTH,EnumFacing.WEST,EnumFacing.EAST};
 static void check(boolean v,String text){checks++;if(!v)throw new AssertionError(text);}
 static void enter(IBlockState s,World w,BlockPos p,Block changed,BlockPos from){entries++;seenState=s;seenWorld=w;seenPos=p;seenChanged=changed;seenFrom=from;}
 static void reset(){entries=0;seenState=null;ProbeHooks.reset();server.powerReads.clear();client.powerReads.clear();}
 static void register(Block b,String name){b.setRegistryName("hbm",name);ForgeRegistries.BLOCKS.register(b);}
 public static void main(String[] args)throws Exception {Bootstrap.register();FMLCommonHandler.instance().beginLoading(net.minecraftforge.fml.server.FMLServerHandler.instance());ModMetadata md=new ModMetadata();md.modId="hbm";md.name="Native neighbor boundary";md.version="1";DummyModContainer c=new DummyModContainer(md);Loader.instance().setupTestHarness(c);Loader.instance().setActiveModContainer(c);server=new NativeWorld(false);client=new NativeWorld(true);ModBlocks.crystal_virus=Blocks.GLASS;
  RUN_CASES
  notifyLifecycle();failureOrder();
  System.out.println("PASS "+checks+" actual-native neighbor/power/removal assertions across "+cases+" complete callbacks, original TNT helpers, native parent and five complete production collaborators. Domain effect sinks are bounded fixtures, not full explosive/piston/crystal gameplay or complete owners.");
 }
 static void clear(NativeWorld w,BlockPos p){for(EnumFacing f:EnumFacing.values())w.setBlockState(p.offset(f),Blocks.AIR.getDefaultState(),2);w.setBlockState(p,Blocks.AIR.getDefaultState(),2);}
 static void runCase(NtmHookBoundary b,String name)throws Exception {
  register(b,"neighbor_probe_"+(cases++));check(b.getClass().getSuperclass().getMethod("neighborChanged",IBlockState.class,World.class,BlockPos.class,Block.class,BlockPos.class).getDeclaringClass()==b.getClass().getSuperclass(),name+" actual native override");BlockPos p=new BlockPos(-3,70,-5),from=new BlockPos(8,74,9);boolean power=Arrays.asList("NukeAntimatter","NukeBalefire","NukeCustom","ExplosiveCharge","DetMiner","BlockPlasticExplosive","BombFlameWar","BombFloat","BlockTNTBase","BombThermo").contains(name);
  for(NativeWorld w:new NativeWorld[]{server,client})for(int supply=-1;supply<6;supply++)for(boolean direct:new boolean[]{false,true}){
   clear(w,p);w.setBlockState(p,b.getStateFromMeta(12),2);if(supply>=0)w.setBlockState(p.offset(POWER[supply]),Blocks.REDSTONE_BLOCK.getDefaultState(),2);b.worldObj=null;b.fire=false;ModBlocks.therm_endo=ModBlocks.therm_exo=null;IBlockState state=w.getBlockState(p);reset();
   if(direct)((Block)b).neighborChanged(Blocks.DIRT.getDefaultState(),w,p,Blocks.GOLD_BLOCK,from);else w.neighborChanged(p,Blocks.GOLD_BLOCK,from);
   boolean executes=direct||!w.isRemote;check(entries==(executes?1:0),name+" direct/native World server gate and once dispatch");
   if(executes){check(seenWorld==w&&seenPos==p&&seenChanged==Blocks.GOLD_BLOCK&&seenFrom==from&&seenState==(direct?Blocks.DIRT.getDefaultState():state),name+" exact native state/target/changed-block/source identity");}
   List<String> expected=new ArrayList<>();boolean removed=false;
   if(executes){if(name.equals("PistonInserter"))expected.add("piston");else if(name.equals("CrystalPulsar")&&!w.isRemote)expected.add("crystal");else if(name.equals("BlockTNTBase")){expected.add(supply>=0?"prime":"fire");removed=supply>=0;}else if(name.equals("BombThermo")&&supply>=0){expected.add("vanilla-explosion");removed=true;}else if(power&&supply>=0)expected.add("explode");else if(name.equals("BlockChargeBase"))removed=true;}
   check(ProbeHooks.calls.equals(expected),name+" unchanged domain call/exception order: "+ProbeHooks.calls+" expected "+expected);
   check(w.isAirBlock(p)==removed,name+" exact genuine native removal branch");
   if(!expected.isEmpty())check(ProbeHooks.world==w&&ProbeHooks.x==p.getX()&&ProbeHooks.y==p.getY()&&ProbeHooks.z==p.getZ(),name+" domain effect coordinates/world");
   if(name.equals("BombFloat"))check(b.worldObj==(executes?w:null),"BombFloat world assignment occurs before power regardless of result");
   if(power){List<String> wanted=new ArrayList<>();if(executes)for(int i=0;i<(supply<0?6:supply+1);i++)wanted.add(p.offset(POWER[i])+"/"+POWER[i]);check(w.powerReads.equals(wanted),name+" actual native boolean six-side order/short circuit");}
  }
  if(name.equals("BlockChargeBase"))attachment(b,p,from);
  if(name.equals("BombThermo"))thermal(b,p,from);
  if(name.equals("CrystalPulsar")){for(NativeWorld w:new NativeWorld[]{server,client}){clear(w,p);w.setBlockState(p,b.getDefaultState(),2);w.setBlockState(p.east(),ModBlocks.crystal_virus.getDefaultState(),2);reset();b.neighborChanged(b.getDefaultState(),w,p,Blocks.AIR,from);check(ProbeHooks.calls.equals(Arrays.asList("crystal")),"original crystal adjacent match precedes remote check");}}
 }
 static void attachment(NtmHookBoundary b,BlockPos p,BlockPos from){for(int meta=0;meta<16;meta++)for(boolean supported:new boolean[]{false,true}){clear(server,p);server.setBlockState(p,b.getStateFromMeta(meta),2);com.hbm.lib.ForgeDirection f=com.hbm.lib.ForgeDirection.getOrientation(meta);if(supported&&meta<6)server.setBlockState(p.add(-f.offsetX,-f.offsetY,-f.offsetZ),Blocks.STONE.getDefaultState(),2);reset();server.neighborChanged(p,Blocks.STONE,from);check(server.isAirBlock(p)==(!supported||meta>=6),"actual metadata owner/directional support/removal preserves UNKNOWN "+meta);check(ProbeHooks.calls.isEmpty(),"attachment removal never invents detonation");}}
 static void thermal(NtmHookBoundary b,BlockPos p,BlockPos from){for(int mode=0;mode<3;mode++){clear(server,p);server.setBlockState(p,b.getDefaultState(),2);server.setBlockState(p.down(),Blocks.REDSTONE_BLOCK.getDefaultState(),2);ModBlocks.therm_endo=mode!=1?b:null;ModBlocks.therm_exo=mode!=0?b:null;reset();server.neighborChanged(p,Blocks.STONE,from);List<String> expected=new ArrayList<>();if(mode!=1)expected.addAll(Arrays.asList("freeze","freezer"));if(mode!=0)expected.addAll(Arrays.asList("scorch","setEntitiesOnFire"));expected.add("vanilla-explosion");check(ProbeHooks.calls.equals(expected)&&server.isAirBlock(p),"thermal identity branches and removal-before-effects order");}}
 static class NotifyBlock extends Block {final List<String> events=new ArrayList<>();NotifyBlock(){super(Material.ROCK);}@Override public void neighborChanged(IBlockState s,World w,BlockPos p,Block b,BlockPos from){events.add(p+"/"+b.getRegistryName()+"/"+from);check(s==w.getBlockState(p),"native notification uses actual target state");}}
 static void notifyLifecycle(){NotifyBlock block=new NotifyBlock();register(block,"notify_probe");BlockPos source=new BlockPos(7,80,7);EnumFacing[] order={EnumFacing.WEST,EnumFacing.EAST,EnumFacing.DOWN,EnumFacing.UP,EnumFacing.NORTH,EnumFacing.SOUTH};for(EnumFacing f:order)server.setBlockState(source.offset(f),block.getDefaultState(),2);server.notifyNeighborsOfStateChange(source,Blocks.GOLD_BLOCK,false);List<String> expected=new ArrayList<>();for(EnumFacing f:order)expected.add(source.offset(f)+"/minecraft:gold_block/"+source);check(block.events.equals(expected),"actual native six-neighbor fanout order and changed/source identity");block.events.clear();server.notifyNeighborsOfStateExcept(source,Blocks.DIRT,EnumFacing.NORTH);expected.clear();for(EnumFacing f:order)if(f!=EnumFacing.NORTH)expected.add(source.offset(f)+"/minecraft:dirt/"+source);check(block.events.equals(expected),"actual native excluded-face fanout");}
 static final class DerivedTnt extends TNT_CASE {int primes;@Override public void prime(World w,int x,int y,int z,int meta,net.minecraft.entity.EntityLivingBase entity){primes++;super.prime(w,x,y,z,meta,entity);}}
 static void failureOrder(){CountingTNT_CASE b=new CountingTNT_CASE();register(b,"failure_probe");BlockPos p=new BlockPos(3,90,3),from=p.down();clear(server,p);server.setBlockState(p,b.getDefaultState(),2);server.setBlockState(p.down(),Blocks.REDSTONE_BLOCK.getDefaultState(),2);reset();ProbeHooks.throwing="prime";try{server.neighborChanged(p,Blocks.STONE,from);throw new AssertionError("missing native crash wrapper");}catch(ReportedException ex){check(ex.getCrashReport().getCrashCause()==ProbeHooks.BOOM,"actual native ReportedException retains original cause");check(server.getBlockState(p).getBlock()==b&&ProbeHooks.calls.equals(Arrays.asList("prime")),"original prime failure occurs before removal");}finally{ProbeHooks.throwing=null;}
  reset();server.failLookup=p;try{server.neighborChanged(p,Blocks.STONE,from);throw new AssertionError("missing lookup failure");}catch(RuntimeException ex){check(ex==ProbeHooks.BOOM&&entries==0,"native state lookup failure precedes callback and is not wrapped");}finally{server.failLookup=null;}
  DerivedTnt child=new DerivedTnt();register(child,"derived_tnt_probe");server.setBlockState(p,child.getDefaultState(),2);reset();server.neighborChanged(p,Blocks.STONE,from);check(child.primes==1&&ProbeHooks.calls.equals(Arrays.asList("prime"))&&server.isAirBlock(p),"native inherited callback retains virtual NTM prime override exactly once");server.setBlockState(p,b.getDefaultState(),2);
  reset();b.fire=true;server.setBlockState(p.down(),Blocks.AIR.getDefaultState(),2);server.neighborChanged(p,Blocks.STONE,from);check(ProbeHooks.calls.equals(Arrays.asList("fire","prime"))&&server.isAirBlock(p),"actual unchanged TNT fire helper native removal path");}
 static final class NativeWorld extends World {
  final Map<Long,Chunk> chunks=new HashMap<>();final List<String> powerReads=new ArrayList<>();BlockPos failLookup;NativeWorld(boolean remote){super(new SaveHandlerMP(),new WorldInfo(new NBTTagCompound()),new WorldProviderSurface(),new Profiler(),remote);provider.setWorld(this);chunkProvider=createChunkProvider();for(int x=-1;x<=1;x++)for(int z=-1;z<=1;z++){Chunk c=new Chunk(this,x,z);c.markLoaded(true);chunks.put(key(x,z),c);}}
  static long key(int x,int z){return ((long)x<<32)^(z&0xffffffffL);}protected IChunkProvider createChunkProvider(){return new IChunkProvider(){public Chunk getLoadedChunk(int x,int z){return chunks.get(key(x,z));}public Chunk provideChunk(int x,int z){return getLoadedChunk(x,z);}public boolean tick(){return false;}public String makeString(){return "real preloaded chunks";}public boolean isChunkGeneratedAt(int x,int z){return getLoadedChunk(x,z)!=null;}};}protected boolean isChunkLoaded(int x,int z,boolean empty){return chunks.containsKey(key(x,z));}public boolean checkLight(BlockPos p){return true;}
  @Override public IBlockState getBlockState(BlockPos p){if(p.equals(failLookup))throw ProbeHooks.BOOM;return super.getBlockState(p);}
  @Override public int getRedstonePower(BlockPos p,EnumFacing f){powerReads.add(p+"/"+f);return super.getRedstonePower(p,f);}
  @Override public Explosion createExplosion(Entity e,double x,double y,double z,float strength,boolean terrain){check(e==null&&strength==5F&&terrain&&isAirBlock(new BlockPos(x,y,z)),"thermal native explosion arguments after real removal");ProbeHooks.call("vanilla-explosion",this,(int)x,(int)y,(int)z);return null;}
 }
}
