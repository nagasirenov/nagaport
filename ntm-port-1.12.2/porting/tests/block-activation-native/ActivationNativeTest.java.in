import java.util.*;import java.lang.reflect.*;
import com.mojang.authlib.GameProfile;import net.minecraft.block.*;import net.minecraft.block.state.*;import net.minecraft.entity.player.*;import net.minecraft.init.Bootstrap;import net.minecraft.item.*;import net.minecraft.util.*;import net.minecraft.util.math.BlockPos;import net.minecraft.world.*;import net.minecraft.world.chunk.*;import net.minecraft.world.storage.*;import net.minecraft.nbt.*;import net.minecraft.profiler.Profiler;import net.minecraft.tileentity.TileEntity;import net.minecraft.server.management.PlayerInteractionManager;
import net.minecraftforge.fml.common.*;import net.minecraftforge.fml.common.network.*;import net.minecraftforge.fml.common.registry.ForgeRegistries;import net.minecraftforge.fml.relauncher.Side;
public class ActivationNativeTest {
 static int checks,cases,guiCalls,shows,callbackCalls;static int lastId;static BlockPos lastPos;static World lastWorld;static EntityPlayer lastPlayer;static final Object gui=new Object();static NativeWorld server,client;
 static void check(boolean v,String text){checks++;if(!v)throw new AssertionError(text);}
 public static void main(String[] args)throws Exception {
  Bootstrap.register();final IFMLSidedHandler real=net.minecraftforge.fml.server.FMLServerHandler.instance();FMLCommonHandler.instance().beginLoading(real);ModMetadata md=new ModMetadata();md.modId="hbm";md.name="Native activation boundary";md.version="1";DummyModContainer mc=new DummyModContainer(md);Loader.instance().setupTestHarness(mc);Loader.instance().setActiveModContainer(mc);
  IFMLSidedHandler presentation=(IFMLSidedHandler)Proxy.newProxyInstance(ActivationNativeTest.class.getClassLoader(),new Class[]{IFMLSidedHandler.class},(self,m,a)->{if(m.getName().equals("getSide"))return Side.CLIENT;if(m.getName().equals("showGuiScreen")){check(a[0]==gui,"real FML registered GUI presentation identity");shows++;return null;}try{return m.invoke(real,a);}catch(InvocationTargetException ex){throw ex.getCause();}});
  Field delegate=FMLCommonHandler.class.getDeclaredField("sidedDelegate");delegate.setAccessible(true);delegate.set(FMLCommonHandler.instance(),presentation);
  NetworkRegistry.INSTANCE.registerGuiHandler(MainRegistry.instance,new IGuiHandler(){public Object getServerGuiElement(int id,EntityPlayer p,World w,int x,int y,int z){throw new AssertionError("unexpected server transport");}public Object getClientGuiElement(int id,EntityPlayer p,World w,int x,int y,int z){guiCalls++;lastId=id;lastPos=new BlockPos(x,y,z);lastWorld=w;lastPlayer=p;return gui;}});
  server=new NativeWorld(false);client=new NativeWorld(true);
  RUN_CASES
  DISPATCH_CASES
  dispatcher();coreFailures();
  System.out.println("PASS "+checks+" actual-native assertions across "+cases+" complete migrated callback methods, exact core/GUI helper methods, real World/Chunk state, native GUI registry routing and PlayerInteractionManager dispatch. Bounded NTM owner/tile and GUI presentation fixtures; not a full owner/mod/client launch.");
 }
 static void resetGui(){guiCalls=shows=0;lastPos=null;lastWorld=null;lastPlayer=null;}
 static void runCase(ExactHelperFixture b,String name,String group,Class<? extends TileEntity> tile,boolean faceId,int constantId)throws Exception {
  b.setRegistryName("hbm","activation_probe_"+(cases++));ForgeRegistries.BLOCKS.register(b);
  check(b.getClass().getMethod("onBlockActivated",World.class,BlockPos.class,IBlockState.class,EntityPlayer.class,EnumHand.class,EnumFacing.class,float.class,float.class,float.class).getDeclaringClass()==b.getClass(),name+" genuinely overrides native Block callback");
  boolean disabled=group.equals("disabled"), core=group.startsWith("core_")||group.equals("standard"), consume=group.equals("standard")||group.equals("core_gui_consume_sneak");BlockPos pos=new BlockPos(-3,70,-5),target=pos.east();
  for(NativeWorld w:new NativeWorld[]{server,client})for(boolean sneak:new boolean[]{false,true})for(boolean present:new boolean[]{false,true})for(boolean hasTile:new boolean[]{false,true}){
   NativePlayer player=new NativePlayer(w);player.setSneaking(sneak);w.tiles.clear();w.setBlockState(pos,b.getStateFromMeta(core?4:12),2);w.setBlockState(target,present?b.getStateFromMeta(12):net.minecraft.init.Blocks.AIR.getDefaultState(),2);if(tile!=null&&hasTile)w.tiles.put(core?target:pos,tile.newInstance());
   for(EnumHand hand:EnumHand.values())for(EnumFacing face:EnumFacing.values()){
    resetGui();boolean value=((Block)b).onBlockActivated(w,pos,net.minecraft.init.Blocks.STONE.getDefaultState(),player,hand,face,Float.NaN,-0.25F,1.25F);
    boolean expected=disabled?false:w.isRemote?true:sneak?consume:core?!(!present):true;boolean opens=!disabled&&!w.isRemote&&!sneak&&(!core||present)&&(tile==null||hasTile);
    check(value==expected,name+" exact boolean "+group+" remote="+w.isRemote+" sneak="+sneak+" core="+present);
    check(guiCalls==(opens?1:0)&&shows==guiCalls,name+" GUI effect exactly once or none");
    if(opens){check(lastId==(faceId?face.getIndex():constantId)&&lastPos.equals(core?target:pos)&&lastWorld==w&&lastPlayer==player,name+" exact real FML handler id/coordinates/world/player");}
   }
  }
  if(tile!=null){NativePlayer p=new NativePlayer(server);server.tiles.clear();server.setBlockState(pos,b.getStateFromMeta(core?4:12),2);server.setBlockState(target,b.getStateFromMeta(12),2);server.tiles.put(core?target:pos,new TileEntity() {});resetGui();try{b.onBlockActivated(server,pos,b.getDefaultState(),p,EnumHand.MAIN_HAND,EnumFacing.UP,0,0,0);throw new AssertionError(name+" lost original wrong-tile cast failure");}catch(ClassCastException expected){check(guiCalls==0,name+" original cast failure before GUI");}}
 }
 static void runDispatched(ExactHelperFixture b,String group,Class<? extends TileEntity> tile)throws Exception {
  boolean core=group.startsWith("core_")||group.equals("standard"),disabled=group.equals("disabled");b.setRegistryName("hbm","actual_dispatch_"+group);ForgeRegistries.BLOCKS.register(b);BlockPos p=new BlockPos(-4,80,3),target=p.east();server.setBlockState(p,b.getStateFromMeta(core?4:12),2);server.setBlockState(target,b.getStateFromMeta(12),2);server.tiles.clear();if(tile!=null)server.tiles.put(core?target:p,tile.newInstance());NativePlayer player=new NativePlayer(server);ItemStack held=new ItemStack(net.minecraft.init.Items.STICK);PlayerInteractionManager manager=new PlayerInteractionManager(server);Field mode=PlayerInteractionManager.class.getDeclaredField("gameType");mode.setAccessible(true);mode.set(manager,GameType.SURVIVAL);
  for(EnumHand hand:EnumHand.values()){player.setHeldItem(hand,held);callbackCalls=0;resetGui();EnumActionResult result=manager.processRightClickBlock(player,server,held,hand,p,EnumFacing.WEST,.2F,.4F,.6F);check(callbackCalls==1,"real server dispatcher reaches complete migrated "+group+" override and native super once");check(result==(disabled?EnumActionResult.PASS:EnumActionResult.SUCCESS)&&guiCalls==(disabled?0:1)&&shows==guiCalls,"real server dispatcher preserves "+group+" result and GUI dispatch");}
 }
 static final class SpyBlock extends ExactHelperFixture {int calls;EnumHand hand;EnumFacing face;BlockPos pos;IBlockState state;float x,y,z;boolean result=true;
  @Override public boolean onBlockActivated(World w,BlockPos p,IBlockState s,EntityPlayer pl,EnumHand h,EnumFacing f,float a,float b,float c){calls++;hand=h;face=f;pos=p;state=s;x=a;y=b;z=c;return result;}}
 static void dispatcher()throws Exception {
  SpyBlock b=new SpyBlock();b.setRegistryName("hbm","activation_dispatch_probe");ForgeRegistries.BLOCKS.register(b);BlockPos pos=new BlockPos(2,70,2);server.setBlockState(pos,b.getStateFromMeta(13),2);NativePlayer player=new NativePlayer(server);PlayerInteractionManager manager=new PlayerInteractionManager(server);Field mode=PlayerInteractionManager.class.getDeclaredField("gameType");mode.setAccessible(true);mode.set(manager,GameType.SURVIVAL);ItemStack nonempty=new ItemStack(net.minecraft.init.Items.STICK);
  for(EnumHand hand:EnumHand.values())for(EnumFacing face:EnumFacing.values())for(boolean result:new boolean[]{false,true})for(boolean empty:new boolean[]{false,true}){
   ItemStack held=empty?ItemStack.EMPTY:nonempty;player.setHeldItem(hand,held);b.calls=0;b.result=result;EnumActionResult outcome=manager.processRightClickBlock(player,server,held,hand,pos,face,.125F,.25F,.75F);
   check(b.calls==1&&b.hand==hand&&b.face==face&&b.pos.equals(pos)&&b.state==server.getBlockState(pos)&&b.x==.125F&&b.y==.25F&&b.z==.75F,"actual server dispatcher native arguments and single virtual invocation");check(outcome==(empty?EnumActionResult.PASS:result?EnumActionResult.SUCCESS:EnumActionResult.PASS),"actual server boolean/result preserves empty-stack PASS nuance");
  }
  Item first=new Item(){@Override public EnumActionResult onItemUseFirst(EntityPlayer p,World w,BlockPos pos,EnumFacing f,float x,float y,float z,EnumHand h){return EnumActionResult.SUCCESS;}};first.setRegistryName("hbm","first_use_probe");ForgeRegistries.ITEMS.register(first);ItemStack stack=new ItemStack(first);player.setHeldItem(EnumHand.MAIN_HAND,stack);b.calls=0;check(manager.processRightClickBlock(player,server,stack,EnumHand.MAIN_HAND,pos,EnumFacing.UP,0,0,0)==EnumActionResult.SUCCESS&&b.calls==0,"actual item-first SUCCESS prevents activation");
 }
 static void coreFailures(){ExactHelperFixture b=new ExactHelperFixture();b.setRegistryName("hbm","activation_core_probe");ForgeRegistries.BLOCKS.register(b);BlockPos a=new BlockPos(3,75,3),z=a.east();server.setBlockState(a,b.getStateFromMeta(4),2);server.setBlockState(z,b.getStateFromMeta(5),2);check(b.findCore(server,a.getX(),a.getY(),a.getZ())==null,"exact core resolver terminates cycle");server.setBlockState(z,b.getStateFromMeta(12),2);check(Arrays.equals(b.findCore(server,a.getX(),a.getY(),a.getZ()),new int[]{z.getX(),z.getY(),z.getZ()}),"exact core resolver clears visit list between clicks");for(int i=0;i<6;i++)check(EnumFacing.values()[i].getIndex()==i&&com.hbm.lib.ForgeDirection.getOrientation(i).ordinal()==i,"actual native and original face index agreement");}
 static final class NativePlayer extends EntityPlayer {NativePlayer(World w){super(w,new GameProfile(new UUID(0,1),"activation-probe"));}public boolean isSpectator(){return false;}public boolean isCreative(){return false;}}
 static final class NativeWorld extends World {
  final Map<Long,Chunk> chunks=new HashMap<>();final Map<BlockPos,TileEntity> tiles=new HashMap<>();NativeWorld(boolean remote){super(new SaveHandlerMP(),new WorldInfo(new NBTTagCompound()),new WorldProviderSurface(),new Profiler(),remote);provider.setWorld(this);chunkProvider=createChunkProvider();for(int x=-1;x<=1;x++)for(int z=-1;z<=1;z++){Chunk c=new Chunk(this,x,z);c.markLoaded(true);chunks.put(key(x,z),c);}}
  static long key(int x,int z){return ((long)x<<32)^(z&0xffffffffL);}protected IChunkProvider createChunkProvider(){return new IChunkProvider(){public Chunk getLoadedChunk(int x,int z){return chunks.get(key(x,z));}public Chunk provideChunk(int x,int z){return getLoadedChunk(x,z);}public boolean tick(){return false;}public String makeString(){return "real preloaded chunks";}public boolean isChunkGeneratedAt(int x,int z){return getLoadedChunk(x,z)!=null;}};}protected boolean isChunkLoaded(int x,int z,boolean empty){return chunks.containsKey(key(x,z));}public boolean checkLight(BlockPos p){return true;}@Override public TileEntity getTileEntity(BlockPos p){return tiles.get(p);}
 }
}
