  try(PrintWriter out=new PrintWriter(args[0])) {
   for(int c=0;c<weights.length;c++) {
    Probe e=new Probe();e.j=weights[c];
    for(int bi=0;bi<RangeVectors.BOXES.length;bi++) {
     double[] b=RangeVectors.BOXES[bi];e.C.b(b[0],b[1],b[2],b[3],b[4],b[5]);
     double edge=e.C.a();double r=edge*(64.0D*weights[c]);double threshold=r*r;double[] ds=RangeVectors.distances(threshold);
     for(int di=0;di<ds.length;di++){out.println(c+"\t"+bi+"\t"+di+"\t"+e.a(ds[di]));rows++;}
