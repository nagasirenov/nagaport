import java.io.*;
public class LegacyRangeTest {
 static class Probe extends sa {
  Probe(){super((ahb)null);}
  protected void c(){}
  protected void a(dh n){}
  protected void b(dh n){}
 }
 static void require(boolean b,String why){if(!b)throw new AssertionError(why);}
 public static void main(String[] args)throws Exception {
  Probe a=new Probe(),other=new Probe();require(a.j==1.0D&&other.j==1.0D,"actual original default weight");a.j*=10;require(a.j==10&&other.j==1,"instance field isolation and Ghost multiply");
  @WEIGHTS@
